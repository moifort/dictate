    "Choix automatique : Claude, sinon OpenAI, sinon Gemini, sinon Apple Intelligence, selon ce qui est détecté.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичен избор: Claude, иначе OpenAI, иначе Gemini, иначе Apple Intelligence, според това какво е открито."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatická volba: Claude, jinak OpenAI, jinak Gemini, jinak Apple Intelligence, podle toho, co je zjištěno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk valg: Claude, ellers OpenAI, ellers Gemini, ellers Apple Intelligence, afhængigt af hvad der findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Wahl: Claude, sonst OpenAI, sonst Gemini, sonst Apple Intelligence, je nachdem, was erkannt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτόματη επιλογή: Claude, αλλιώς OpenAI, αλλιώς Gemini, αλλιώς Apple Intelligence, ανάλογα με το τι εντοπίζεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic choice: Claude, else OpenAI, else Gemini, else Apple Intelligence, depending on what is detected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elección automática: Claude, si no OpenAI, si no Gemini, si no Apple Intelligence, según lo que se detecte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaatne valik: Claude, muidu OpenAI, muidu Gemini, muidu Apple Intelligence, olenevalt sellest, mis tuvastatakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen valinta: Claude, muuten OpenAI, muuten Gemini, muuten Apple Intelligence, sen mukaan, mitä havaitaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choix automatique : Claude, sinon OpenAI, sinon Gemini, sinon Apple Intelligence, selon ce qui est détecté."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski odabir: Claude, inače OpenAI, inače Gemini, inače Apple Intelligence, ovisno o tome što je otkriveno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikus választás: Claude, különben OpenAI, különben Gemini, különben Apple Intelligence, attól függően, mi észlelhető."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelta automatica: Claude, altrimenti OpenAI, altrimenti Gemini, altrimenti Apple Intelligence, in base a ciò che viene rilevato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatinis pasirinkimas: „Claude“, kitu atveju „OpenAI“, kitu atveju „Gemini“, kitu atveju „Apple Intelligence“, atsižvelgiant į tai, kas aptikta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
