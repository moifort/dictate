          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Model prepisu beží na tomto Macu, bez siete. Sťahuje sa len raz, asi %lld MB."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model za prepis teče na tem Macu, brez omrežja. Prenese se samo enkrat, približno %lld MB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En transkriptionsmodell körs på den här datorn, utan nätverk. Den hämtas bara en gång, cirka %lld MB."
