    "Dictate insère le texte brut transcrit. La relecture s'active dans les Réglages.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate вмъква суровата транскрипция. Прегледът може да се включи в Настройки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate vkládá surový přepis. Kontrolu lze zapnout v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate indsætter den rå transskription. Gennemgangen kan slås til i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate fügt das rohe Transkript ein. Die Korrektur lässt sich in den Einstellungen aktivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Dictate εισάγει την ακατέργαστη μεταγραφή. Ο έλεγχος μπορεί να ενεργοποιηθεί στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate inserts the raw transcript. The review can be turned on in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate inserta la transcripción sin revisar. La revisión se puede activar en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate sisestab toortranskriptsiooni. Ülevaatuse saab sisse lülitada seadetes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate lisää raa’an litteroinnin. Tarkistuksen voi ottaa käyttöön asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate insère le texte brut transcrit. La relecture s'active dans les Réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate umeće neobrađeni transkript. Pregled se može uključiti u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Dictate a nyers átiratot szúrja be. Az ellenőrzés a Beállításokban kapcsolható be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate inserisce la trascrizione grezza. La rilettura si può attivare nelle Impostazioni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dictate“ įterpia neapdorotą transkripciją. Peržiūrą galima įjungti nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate ievieto neapstrādātu transkripciju. Pārskatīšanu var ieslēgt iestatījumos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate idaħħal it-traskrizzjoni mhux maħduma. Ir-reviżjoni tista’ tinxtegħel fis-settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate voegt het ruwe transcript in. De controle kan worden ingeschakeld in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate wstawia surową transkrypcję. Korektę można włączyć w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dictate insere a transcrição bruta. A revisão pode ser ativada nos Ajustes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate inserează transcrierea brută. Revizuirea poate fi activată în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate вставляет исходную расшифровку. Проверку можно включить в Настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate vkladá surový prepis. Kontrolu možno zapnúť v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate vstavi surov prepis. Pregled lahko vklopite v nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate infogar den råa transkriptionen. Granskningen kan slås på i Inställningar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate вставляє сиру транскрипцію. Перевірку можна ввімкнути в Параметрах."
          }
        }
      }
    },
    "Dictate n'écoute que pendant que vous maintenez la touche de dictée. L'audio est transcrit sur ce Mac et n'en sort jamais.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate слуша само докато държите клавиша за диктовка. Аудиото се транскрибира на този Mac и никога не го напуска."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate poslouchá jen tehdy, když držíte klávesu diktování. Zvuk se přepisuje na tomto Macu a nikdy ho neopouští."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate lytter kun, mens du holder dikteringstasten nede. Lyden transskriberes på denne Mac og forlader den aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate hört nur zu, solange du die Diktiertaste gedrückt hältst. Das Audio wird auf diesem Mac transkribiert und verlässt ihn nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Dictate ακούει μόνο όσο κρατάτε πατημένο το πλήκτρο υπαγόρευσης. Ο ήχος μεταγράφεται σε αυτό το Mac και δεν το εγκαταλείπει ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate only listens while you hold the dictation key. The audio is transcribed on this Mac and never leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate solo escucha mientras mantienes pulsada la tecla de dictado. El audio se transcribe en este Mac y nunca sale de él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate kuulab ainult siis, kui hoiate dikteerimisklahvi all. Heli transkribeeritakse selles Macis ja see ei lahku sealt kunagi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate kuuntelee vain, kun pidät sanelunäppäintä painettuna. Ääni litteroidaan tällä Macilla, eikä se koskaan poistu siltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate n'écoute que pendant que vous maintenez la touche de dictée. L'audio est transcrit sur ce Mac et n'en sort jamais."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate sluša samo dok držite tipku za diktiranje. Zvuk se transkribira na ovom Macu i nikad ga ne napušta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Dictate csak akkor figyel, amíg lenyomva tartja a diktálóbillentyűt. A hang átírása ezen a Macen történik, és soha nem hagyja el azt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate ascolta solo mentre tieni premuto il tasto di dettatura. L’audio viene trascritto su questo Mac e non lo lascia mai."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dictate“ klausosi tik tol, kol laikote nuspaudę diktavimo klavišą. Garsas transkribuojamas šiame „Mac“ ir niekada jo nepalieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate klausās tikai tad, kamēr turat nospiestu diktēšanas taustiņu. Audio tiek transkribēts šajā Mac datorā un nekad to neatstāj."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate jisma’ biss waqt li żżomm it-tasta tad-dettatura magħfusa. L-awdjo jiġi traskritt fuq dan il-Mac u qatt ma joħroġ minnu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate luistert alleen terwijl je de dicteertoets ingedrukt houdt. De audio wordt op deze Mac getranscribeerd en verlaat hem nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate słucha tylko wtedy, gdy trzymasz klawisz dyktowania. Dźwięk jest transkrybowany na tym Macu i nigdy go nie opuszcza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dictate só escuta enquanto você mantém a tecla de ditado pressionada. O áudio é transcrito neste Mac e nunca sai dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate ascultă doar cât timp țineți apăsată tasta de dictare. Sunetul este transcris pe acest Mac și nu îl părăsește niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate слушает, только пока вы удерживаете клавишу диктовки. Аудио расшифровывается на этом Mac и никогда его не покидает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate počúva len vtedy, keď držíte kláves diktovania. Zvuk sa prepisuje na tomto Macu a nikdy ho neopúšťa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate posluša samo, dokler držite tipko za narekovanje. Zvok se prepiše na tem Macu in ga nikoli ne zapusti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate lyssnar bara medan du håller ned dikteringstangenten. Ljudet transkriberas på den här datorn och lämnar den aldrig."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate слухає, лише поки ви утримуєте клавішу диктування. Аудіо транскрибується на цьому Mac і ніколи його не залишає."
          }
        }
      }
    },
    "Dictate ne tourne pas depuis un emplacement où il peut se mettre à jour.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate не работи от място, където може да се обновява сам."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate neběží z umístění, kde se může sám aktualizovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate kører ikke fra en placering, hvor den kan opdatere sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate läuft nicht von einem Ort aus, an dem es sich selbst aktualisieren kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Dictate δεν εκτελείται από τοποθεσία όπου μπορεί να ενημερώσει τον εαυτό του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate is not running from a location where it can update itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate no se está ejecutando desde una ubicación en la que pueda actualizarse."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate ei tööta asukohast, kus see saaks end ise värskendada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate ei toimi sijainnista, jossa se voisi päivittää itsensä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate ne tourne pas depuis un emplacement où il peut se mettre à jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate se ne pokreće s lokacije na kojoj se može sam ažurirati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Dictate nem olyan helyről fut, ahol frissíteni tudná magát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate non è in esecuzione da una posizione in cui può aggiornarsi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dictate“ paleista ne iš vietos, kurioje gali pati atsinaujinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate nedarbojas no vietas, kur tas var pats sevi atjaunināt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate mhux qed jaħdem minn post fejn jista’ jaġġorna lilu nnifsu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate draait niet vanaf een locatie waar het zichzelf kan bijwerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate nie działa z miejsca, w którym może się samo uaktualnić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dictate não está sendo executado de um local em que possa se atualizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate nu rulează dintr-un loc în care se poate actualiza singur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate запущен из места, где он не может обновлять себя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate nebeží z umiestnenia, kde sa môže sám aktualizovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate ne teče z mesta, kjer se lahko sam posodobi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate körs inte från en plats där det kan uppdatera sig självt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate запущено з місця, де він не може оновлювати себе."
          }
        }
      }
    },
