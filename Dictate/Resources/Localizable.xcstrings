    "Fichier non exécutable : détection automatique utilisée.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлът не е изпълним: използва се автоматично откриване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor není spustitelný: použije se automatické zjišťování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kan ikke udføres: automatisk registrering bruges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei ist nicht ausführbar: Die automatische Erkennung wird verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο δεν είναι εκτελέσιμο: χρησιμοποιείται ο αυτόματος εντοπισμός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File is not executable: automatic detection is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no es ejecutable: se usa la detección automática."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail pole käivitatav: kasutatakse automaatset tuvastamist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostoa ei voi suorittaa: käytetään automaattista tunnistusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier non exécutable : détection automatique utilisée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka nije izvršna: koristi se automatsko otkrivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl nem végrehajtható: az automatikus észlelés lesz használva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non è eseguibile: viene usato il rilevamento automatico."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Failas nėra vykdomasis: naudojamas automatinis aptikimas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fails nav izpildāms: tiek izmantota automātiskā noteikšana."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-fajl mhux eżegwibbli: tintuża l-għażla awtomatika."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestand is niet uitvoerbaar: de automatische detectie wordt gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik nie jest wykonywalny: używane jest wykrywanie automatyczne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não é executável: a detecção automática é usada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul nu este executabil: se folosește detectarea automată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не является исполняемым: используется автоматическое определение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
