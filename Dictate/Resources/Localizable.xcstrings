    "« Appuyer sur la touche 🌐 pour » → « Ne rien faire ».": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Натиснете клавиша 🌐 за“ → „Не прави нищо“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Stisknutí klávesy 🌐“ → „Nedělat nic“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tryk på 🌐-tasten for at” → “Gør intet”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Drücken der 🌐-Taste“ → „Keine Aktion“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "«Πάτημα πλήκτρου 🌐 για» → «Καμία ενέργεια»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Press 🌐 key to” → “Do Nothing”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Al pulsar la tecla 🌐» → «No hacer nada»."
          }
        },
