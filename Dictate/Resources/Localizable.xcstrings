    "Dites « émoji fusée » ou « smiley qui pleure de rire » : 🚀, 😂.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кажете „емоджи ракета“ или „усмивка плаче от смях“: 🚀, 😂."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekněte „emoji raketa“ nebo „smajlík slzy smíchu“: 🚀, 😂."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sig “emoji raket” eller “smiley der græder af grin”: 🚀, 😂."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag „Emoji Rakete“ oder „Smiley Tränen lachend“: 🚀, 😂."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πείτε «emoji πύραυλος» ή «φατσούλα που κλαίει από τα γέλια»: 🚀, 😂."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “emoji rocket” or “smiley crying with laughter”: 🚀, 😂."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di «emoji cohete» o «smiley llorando de risa»: 🚀, 😂."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Öelge „emoji rakett“ või „naerunägu nutab naerust“: 🚀, 😂."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sano ”emoji raketti” tai ”hymiö itkee naurusta”: 🚀, 😂."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites « émoji fusée » ou « smiley qui pleure de rire » : 🚀, 😂."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recite „emoji raketa” ili „smajlić plače od smijeha”: 🚀, 😂."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondja: „emoji rakéta” vagy „szmájli sír a nevetéstől”: 🚀, 😂."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di’ “emoji razzo” o “smiley che piange dal ridere”: 🚀, 😂."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasakykite „emoji raketa“ arba „šypsenėlė verkia iš juoko“: 🚀, 😂."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakiet “emoji raķete” vai “smaidiņš raud no smiekliem”: 🚀, 😂."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għid “emoji rokit” jew “smiley jibki bid-daħk”: 🚀, 😂."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg ‘emoji raket’ of ‘smiley tranen van het lachen’: 🚀, 😂."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz „emoji rakieta” lub „buźka płacze ze śmiechu”: 🚀, 😂."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga “emoji foguete” ou “smiley chorando de rir”: 🚀, 😂."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuneți „emoji rachetă” sau „smiley care plânge de râs”: 🚀, 😂."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите «эмодзи ракета» или «смайлик плачет от смеха»: 🚀, 😂."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povedzte „emoji raketa“ alebo „smajlík slzy smiechu“: 🚀, 😂."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
