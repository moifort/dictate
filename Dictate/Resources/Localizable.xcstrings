    "option + espace suffit, même par-dessus une app en plein écran.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "option + интервал е достатъчно, дори върху приложение на цял екран."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stačí option + mezerník, i nad aplikací na celé obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "option + mellemrum er nok, også oven på en app i fuld skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "option + Leertaste genügt, auch über einer App im Vollbildmodus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το option + διάστημα αρκεί, ακόμη και πάνω από εφαρμογή σε πλήρη οθόνη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "option + space is all it takes, even over a full-screen app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta con opción + espacio, incluso sobre una app a pantalla completa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Piisab klahvidest option + tühik, isegi täisekraanil oleva rakenduse kohal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "optio + välilyönti riittää, myös koko näytön apin päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "option + espace suffit, même par-dessus une app en plein écran."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoljno je option + razmaknica, čak i iznad aplikacije preko cijelog zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elég az option + szóköz, teljes képernyős app fölött is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta opzione + spazio, anche sopra un’app a tutto schermo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakanka „option“ + tarpo klavišo, net virš programos visame ekrane."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pietiek ar option + atstarpi, pat virs pilnekrāna lietotnes."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "option + spazju biżżejjed, anke fuq app fi skrin sħiħ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "option + spatie volstaat, ook boven een app in volledig scherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy option + spacja, nawet nad aplikacją na pełnym ekranie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta option + espaço, mesmo sobre um app em tela cheia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "opțiune + spațiu este suficient, chiar și peste o aplicație pe tot ecranul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно option + пробел, даже поверх приложения в полноэкранном режиме."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stačí option + medzerník, aj nad aplikáciou na celej obrazovke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolj je option + preslednica, tudi nad aplikacijo v celozaslonskem načinu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "option + mellanslag räcker, även över en app i helskärm."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Достатньо option + пробіл, навіть поверх програми на весь екран."
          }
        }
      }
