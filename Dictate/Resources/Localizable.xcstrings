    "Maintenez 🌐 fn pour dicter. macOS doit la laisser libre : Clavier → « Appuyer sur la touche 🌐 pour » → « Ne rien faire ».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold 🌐 fn to dictate. macOS must leave it free: Keyboard → “Press 🌐 key to” → “Do Nothing”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez 🌐 fn pour dicter. macOS doit la laisser libre : Clavier → « Appuyer sur la touche 🌐 pour » → « Ne rien faire »."
          }
        }
      }
    },
