    "Chargement de %@… Dictate est indisponible en attendant.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареждане на %@… Дотогава Dictate не е наличен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítá se %@… Do té doby není Dictate k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæser %@… Dictate er ikke tilgængelig indtil da."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird geladen … Dictate ist bis dahin nicht verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φόρτωση %@… Το Dictate δεν είναι διαθέσιμο μέχρι τότε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading %@… Dictate is unavailable until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando %@… Dictate no está disponible hasta entonces."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ laadimine… Dictate pole seni saadaval."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladataan mallia %@… Dictate ei ole käytettävissä ennen sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement de %@… Dictate est indisponible en attendant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
