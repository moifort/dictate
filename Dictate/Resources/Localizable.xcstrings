    "Hésitations, ponctuation et jargon corrigés, par Apple Intelligence sur ce Mac ou par Claude.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колебания, пунктуация и жаргон се поправят от Apple Intelligence на този Mac или от Claude."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaváhání, interpunkce a žargon opraveny, Apple Intelligence na tomto Macu nebo Claudem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tøven, tegnsætning og fagsprog rettes, af Apple Intelligence på denne Mac eller af Claude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zögern, Satzzeichen und Fachbegriffe korrigiert, von Apple Intelligence auf diesem Mac oder von Claude."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δισταγμοί, στίξη και ορολογία διορθώνονται, από το Apple Intelligence σε αυτό το Mac ή από το Claude."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesitations, punctuation and jargon fixed, by Apple Intelligence on this Mac or by Claude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Titubeos, puntuación y jerga corregidos, por Apple Intelligence en este Mac o por Claude."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõhklused, kirjavahemärgid ja erialasõnavara parandatakse, selles Macis Apple Intelligence’i või Claude’i abil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Epäröinnit, välimerkit ja ammattisanasto korjataan, Apple Intelligencen toimesta tällä Macilla tai Clauden toimesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hésitations, ponctuation et jargon corrigés, par Apple Intelligence sur ce Mac ou par Claude."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oklijevanja, interpunkcija i žargon ispravljeni, s pomoću Apple Intelligencea na ovom Macu ili Claudea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hezitálások, írásjelek és szakzsargon kijavítva, az Apple Intelligence által ezen a Macen vagy a Claude által."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esitazioni, punteggiatura e gergo corretti, da Apple Intelligence su questo Mac o da Claude."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvejonės, skyryba ir žargonas pataisomi – „Apple Intelligence“ šiame „Mac“ arba „Claude“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilcināšanās, pieturzīmes un žargons tiek laboti — to dara Apple Intelligence šajā Mac datorā vai Claude."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eżitazzjonijiet, punteġġjatura u ġargon ikkoreġuti, minn Apple Intelligence fuq dan il-Mac jew minn Claude."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aarzelingen, interpunctie en jargon gecorrigeerd, door Apple Intelligence op deze Mac of door Claude."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahania, interpunkcja i żargon poprawione przez Apple Intelligence na tym Macu lub przez Claude."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesitações, pontuação e jargão corrigidos, pela Apple Intelligence neste Mac ou pelo Claude."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezitări, punctuație și jargon corectate, de Apple Intelligence pe acest Mac sau de Claude."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запинки, пунктуация и жаргон исправлены — Apple Intelligence на этом Mac или Claude."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaváhania, interpunkcia a žargón opravené, Apple Intelligence na tomto Macu alebo Claudom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obotavljanja, ločila in žargon popravljeni, z Apple Intelligence na tem Macu ali s Claudom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvekljud, skiljetecken och jargong rättas, av Apple Intelligence på den här datorn eller av Claude."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вагання, пунктуацію та жаргон виправлено — Apple Intelligence на цьому Mac або Claude."
          }
        }
      }
    },
