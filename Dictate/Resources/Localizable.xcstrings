            "value": "%@ betöltése… A Dictate addig nem érhető el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamento di %@… Dictate non è disponibile fino ad allora."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įkeliama %@… Iki tol „Dictate“ nepasiekiama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielādē %@… Līdz tam Dictate nav pieejams."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qed jitgħabba %@… Dictate mhux disponibbli sa dak il-ħin."
          }
        },
        "nl": {
          "stringUnit": {
