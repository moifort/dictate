            "value": "Модель працює локально. Ваш голос ніколи не залишає комп’ютер."
          }
        }
      }
    },
    "Le texte transcrit est inséré tel quel, hésitations comprises.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипцията се вмъква както е, с колебанията."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepis se vloží tak, jak je, včetně zaváhání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transskriptionen indsættes, som den er, med tøven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript wird unverändert eingefügt, mit allen Zögerlauten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μεταγραφή εισάγεται ως έχει, μαζί με τους δισταγμούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript is inserted as is, hesitations included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción se inserta tal cual, titubeos incluidos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptsioon sisestatakse nii, nagu see on, koos kõhklustega."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Litterointi lisätään sellaisenaan, epäröinteineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte transcrit est inséré tel quel, hésitations comprises."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript se umeće kakav jest, zajedno s oklijevanjima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átirat változatlanul kerül beszúrásra, a hezitálásokkal együtt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione viene inserita così com’è, esitazioni comprese."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripcija įterpiama tokia, kokia yra, su dvejonėmis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripcija tiek ievietota tāda, kāda tā ir, ar vilcināšanos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-traskrizzjoni tiddaħħal kif inhi, bl-eżitazzjonijiet b’kollox."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het transcript wordt ongewijzigd ingevoegd, inclusief aarzelingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja jest wstawiana bez zmian, razem z wahaniami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição é inserida como está, com as hesitações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrierea este inserată ca atare, cu tot cu ezitări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка вставляется как есть, вместе с запинками."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepis sa vloží tak, ako je, vrátane zaváhaní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepis se vstavi tak, kot je, skupaj z obotavljanji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptionen infogas som den är, med tvekljud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипція вставляється як є, разом із ваганнями."
          }
        }
      }
    },
