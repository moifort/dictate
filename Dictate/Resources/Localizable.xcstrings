    "S'il n'y figure pas, glissez l'app depuis le Finder dans la liste.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако го няма там, изтеглете приложението от Finder в списъка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud tam není, přetáhněte aplikaci z Finderu do seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis den ikke er der, så træk appen fra Finder til listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sie dort fehlt, ziehe die App aus dem Finder in die Liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν δεν υπάρχει εκεί, σύρετε την εφαρμογή από το Finder στη λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it is not there, drag the app from the Finder into the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no aparece, arrastra la app desde el Finder a la lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui seda seal pole, lohistage rakendus Finderist loendisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sitä ei ole luettelossa, vedä appi Finderista luetteloon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il n'y figure pas, glissez l'app depuis le Finder dans la liste."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je nema, povucite aplikaciju iz Findera na popis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha nincs ott, húzza az appot a Finderből a listába."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non c’è, trascina l’app dal Finder nell’elenco."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei jos ten nėra, nuvilkite programą iš „Finder“ į sąrašą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja tās tur nav, ievelciet lietotni sarakstā no Finder."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jekk mhix hemm, kaxkar l-app mill-Finder għal ġol-lista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat de app er niet bij, sleep hem dan vanuit de Finder naar de lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli jej tam nie ma, przeciągnij aplikację z Findera na listę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ele não estiver lá, arraste o app do Finder para a lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă nu este acolo, trageți aplicația din Finder în listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если его там нет, перетяните приложение из Finder в список."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak tam nie je, potiahnite aplikáciu z Findera do zoznamu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če je ni tam, povlecite aplikacijo iz Finderja na seznam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om den inte finns där drar du appen från Finder till listan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо її там немає, перетягніть програму з Finder до списку."
          }
        }
      }
    },
    "Sans abonnement : Claude via votre clé API Anthropic, facturée à l'usage.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без абонамент: Claude чрез вашия API ключ за Anthropic, таксува се според използването."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez předplatného: Claude přes váš klíč API Anthropic, účtováno podle spotřeby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden abonnement: Claude via din Anthropic-API-nøgle, afregnet efter forbrug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Abo: Claude über deinen Anthropic-API-Schlüssel, Abrechnung nach Verbrauch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς συνδρομή: Claude μέσω του κλειδιού API Anthropic, με χρέωση ανά χρήση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a subscription: Claude through your Anthropic API key, billed by usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin suscripción: Claude con tu clave de API de Anthropic, facturada por uso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilma tellimuseta: Claude teie Anthropicu API-võtme kaudu, tasu kasutuse järgi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman tilausta: Claude Anthropicin API-avaimesi kautta, laskutus käytön mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans abonnement : Claude via votre clé API Anthropic, facturée à l'usage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez pretplate: Claude putem vašeg Anthropic API ključa, naplata po potrošnji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előfizetés nélkül: Claude az Ön Anthropic API-kulcsán keresztül, használat alapján számlázva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza abbonamento: Claude tramite la tua chiave API Anthropic, fatturata a consumo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Be prenumeratos: „Claude“ per jūsų „Anthropic“ API raktą, apmokestinama pagal naudojimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez abonementa: Claude ar jūsu Anthropic API atslēgu, maksa par lietojumu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mingħajr abbonament: Claude permezz taċ-ċavetta API ta’ Anthropic tiegħek, imħallsa skont l-użu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder abonnement: Claude via je Anthropic-API-sleutel, afgerekend op verbruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez subskrypcji: Claude przez Twój klucz API Anthropic, opłata według zużycia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem assinatura: Claude pela sua chave de API da Anthropic, cobrada por uso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără abonament: Claude prin cheia dvs. API Anthropic, facturată la consum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без подписки: Claude через ваш API-ключ Anthropic, оплата по использованию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez predplatného: Claude cez váš kľúč API Anthropic, účtované podľa spotreby."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez naročnine: Claude prek vašega ključa API Anthropic, obračun po porabi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan abonnemang: Claude via din Anthropic-API-nyckel, debiteras efter användning."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без підписки: Claude через ваш API-ключ Anthropic, оплата за використання."
          }
        }
      }
    },
