    "Aucune app : Entrée n'est jamais pressée.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма приложение: Return никога не се натиска."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná aplikace: Return se nikdy nestiskne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen app: der trykkes aldrig på Retur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App: Der Zeilenschalter wird nie gedrückt."
          }
        },
