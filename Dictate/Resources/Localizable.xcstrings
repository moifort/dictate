    "Le modèle tourne en local. Votre voix ne quitte pas l'ordinateur.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделът работи локално. Гласът ви никога не напуска компютъра."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model běží lokálně. Váš hlas nikdy neopustí počítač."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen kører lokalt. Din stemme forlader aldrig computeren."
          }
        },
        "de": {
