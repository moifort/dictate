            "state": "translated",
            "value": "Claude on välja logitud: käivitage terminalis „claude auth login“."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude on kirjautunut ulos: suorita päätteessä ”claude auth login”."
          }
