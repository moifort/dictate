    "Votre clé API Anthropic, facturée à l'usage. Pour qui n'a pas d'abonnement Claude.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашият API ключ за Anthropic, таксува се според използването. За тези без абонамент за Claude."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš klíč API Anthropic, účtováno podle spotřeby. Pro ty, kdo nemají předplatné Claude."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Anthropic-API-nøgle, afregnet efter forbrug. Til dem uden Claude-abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anthropic-API-Schlüssel, Abrechnung nach Verbrauch. Für alle ohne Claude-Abo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί API Anthropic, με χρέωση ανά χρήση. Για όσους δεν έχουν συνδρομή Claude."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Anthropic API key, billed by usage. For those without a Claude subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de API de Anthropic, facturada por uso. Para quienes no tienen suscripción a Claude."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie Anthropicu API-võti, tasu kasutuse järgi. Neile, kellel pole Claude’i tellimust."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropicin API-avaimesi, laskutus käytön mukaan. Niille, joilla ei ole Claude-tilausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé API Anthropic, facturée à l'usage. Pour qui n'a pas d'abonnement Claude."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Anthropic API ključ, naplata po potrošnji. Za one bez pretplate na Claude."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ön Anthropic API-kulcsa, használat alapján számlázva. Azoknak, akiknek nincs Claude-előfizetésük."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave API Anthropic, fatturata a consumo. Per chi non ha un abbonamento Claude."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų „Anthropic“ API raktas, apmokestinama pagal naudojimą. Tiems, kurie neturi „Claude“ prenumeratos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu Anthropic API atslēga, maksa par lietojumu. Tiem, kam nav Claude abonementa."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iċ-ċavetta API ta’ Anthropic tiegħek, imħallsa skont l-użu. Għal min m’għandux abbonament ta’ Claude."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Anthropic-API-sleutel, afgerekend op verbruik. Voor wie geen Claude-abonnement heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój klucz API Anthropic, opłata według zużycia. Dla osób bez subskrypcji Claude."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave de API da Anthropic, cobrada por uso. Para quem não tem assinatura do Claude."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia dvs. API Anthropic, facturată la consum. Pentru cei fără abonament Claude."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш API-ключ Anthropic, оплата по использованию. Для тех, у кого нет подписки Claude."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš kľúč API Anthropic, účtované podľa spotreby. Pre tých, ktorí nemajú predplatné Claude."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ključ API Anthropic, obračun po porabi. Za tiste brez naročnine Claude."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Anthropic-API-nyckel, debiteras efter användning. För dig utan Claude-abonnemang."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш API-ключ Anthropic, оплата за використання. Для тих, хто не має підписки Claude."
          }
        }
      }
