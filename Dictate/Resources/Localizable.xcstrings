    "Sans effet tant que le lexique est vide.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма ефект, докато лексиконът е празен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez účinku, dokud je lexikon prázdný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen effekt, så længe leksikonet er tomt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Wirkung, solange das Lexikon leer ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία επίδραση όσο το λεξικό είναι κενό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No effect while the lexicon is empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin efecto mientras el léxico esté vacío."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõju puudub, kuni leksikon on tühi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vaikutusta, kun sanasto on tyhjä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans effet tant que le lexique est vide."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema učinka dok je leksikon prazan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs hatása, amíg a lexikon üres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun effetto finché il lessico è vuoto."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neveikia, kol leksikonas tuščias."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav ietekmes, kamēr leksikons ir tukšs."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ebda effett sakemm il-lessiku jkun vojt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen effect zolang het lexicon leeg is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak efektu, dopóki leksykon jest pusty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem efeito enquanto o léxico estiver vazio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără efect cât timp lexicul este gol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не действует, пока лексикон пуст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez účinku, kým je lexikón prázdny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez učinka, dokler je leksikon prazen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen effekt så länge lexikonet är tomt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не діє, поки лексикон порожній."
          }
        }
      }
    },
    "Semaine": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Седмица"
          }
