    "Claude relit vos dictées avec votre abonnement.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude преглежда диктовките ви с вашия абонамент."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude kontroluje vaše diktáty v rámci vašeho předplatného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude gennemgår dine diktater med dit abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude korrigiert deine Diktate mit deinem Abo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Claude ελέγχει τις υπαγορεύσεις σας με τη συνδρομή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude reviews your dictations with your subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude revisa tus dictados con tu suscripción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude vaatab teie dikteerimised üle teie tellimusega."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude tarkistaa sanelusi tilauksellasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude relit vos dictées avec votre abonnement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude pregledava vaše diktate s vašom pretplatom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Claude az Ön előfizetésével ellenőrzi a diktálásait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude rilegge le tue dettature con il tuo abbonamento."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Claude“ peržiūri jūsų diktavimus naudodamas jūsų prenumeratą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude pārskata jūsu diktējumus ar jūsu abonementu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude jirrevedi d-dettaturi tiegħek bl-abbonament tiegħek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude kijkt je dictaten na met je abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude sprawdza Twoje dyktowania w ramach Twojej subskrypcji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude revisa seus ditados com sua assinatura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude vă revizuiește dictările cu abonamentul dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude проверяет ваши диктовки по вашей подписке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude kontroluje vaše diktáty v rámci vášho predplatného."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude pregleduje vaše nareke z vašo naročnino."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude granskar dina dikteringar med ditt abonnemang."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude перевіряє ваші диктування за вашою підпискою."
          }
        }
