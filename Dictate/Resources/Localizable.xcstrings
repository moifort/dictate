    "Connectez-vous une fois dans Claude Code ou l'app Claude, puis revérifiez.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влезте веднъж в Claude Code или в приложението Claude и проверете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se jednou v Claude Code nebo v aplikaci Claude a pak zkontrolujte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind én gang i Claude Code eller Claude-appen, og tjek igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich einmal in Claude Code oder der Claude-App an und prüfe dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε μία φορά στο Claude Code ή στην εφαρμογή Claude και ελέγξτε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in once in Claude Code or the Claude app, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión una vez en Claude Code o en la app Claude y vuelve a comprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Logige üks kord sisse Claude Code’is või rakenduses Claude ja kontrollige siis uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu kerran Claude Codeen tai Claude-appiin ja tarkista sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous une fois dans Claude Code ou l'app Claude, puis revérifiez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se jednom u Claude Code ili aplikaciju Claude pa provjerite ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be egyszer a Claude Code-ban vagy a Claude appban, majd ellenőrizze újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi una volta in Claude Code o nell’app Claude, poi verifica di nuovo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieną kartą prisijunkite programoje „Claude Code“ arba „Claude“, tada patikrinkite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienreiz pierakstieties Claude Code vai lietotnē Claude un pēc tam pārbaudiet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Illoggja darba f’Claude Code jew fl-app Claude, imbagħad erġa’ ċċekkja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log één keer in bij Claude Code of de Claude-app en controleer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się raz w Claude Code lub aplikacji Claude, a potem sprawdź ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão uma vez no Claude Code ou no app Claude e verifique novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificați-vă o dată în Claude Code sau în aplicația Claude, apoi verificați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите один раз в Claude Code или приложение Claude, затем проверьте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihláste sa raz v Claude Code alebo v aplikácii Claude a potom skontrolujte znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkrat se prijavite v Claude Code ali aplikacijo Claude, nato preverite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in en gång i Claude Code eller Claude-appen och kontrollera sedan igen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть один раз у Claude Code або програму Claude, а потім перевірте знову."
          }
        }
      }
    },
