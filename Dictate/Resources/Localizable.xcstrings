            "value": "%@ laden… Dictate is tot dan niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytywanie %@… Do tego czasu Dictate jest niedostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregando %@… O Dictate fica indisponível até lá."
          }
        },
