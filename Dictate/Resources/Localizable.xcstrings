            "state": "translated",
            "value": "„Press 🌐 key to“ → „Do Nothing“."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Paina 🌐-näppäintä:” → ”Älä tee mitään”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Appuyer sur la touche 🌐 pour » → « Ne rien faire »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Pritisnite tipku 🌐 za” → „Ne čini ništa”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„A 🌐 billentyű megnyomásakor” → „Ne történjen semmi”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Premi il tasto 🌐 per” → “Nessuna azione”."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Press 🌐 key to“ → „Do Nothing“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Press 🌐 key to” → “Do Nothing”."
          }
