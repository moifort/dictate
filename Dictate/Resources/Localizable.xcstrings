    "Apple Intelligence n'a pas répondu : texte brut inséré.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence не отговори: вмъкнат е суровият текст."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence neodpověděla: vložen surový text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence svarede ikke: rå tekst indsat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence hat nicht geantwortet: Rohtext eingefügt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence δεν απάντησε: εισήχθη το ακατέργαστο κείμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence did not answer: raw text inserted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no ha respondido: se ha insertado el texto sin revisar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ei vastanud: sisestati toortekst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ei vastannut: raakateksti lisätty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n'a pas répondu : texte brut inséré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nije odgovorio: umetnut je neobrađeni tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence nem válaszolt: a nyers szöveg lett beszúrva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence non ha risposto: inserito il testo grezzo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Apple Intelligence“ neatsakė: įterptas neapdorotas tekstas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence neatbildēja: ievietots neapstrādāts teksts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ma weġibx: iddaħħal it-test mhux maħdum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence heeft niet geantwoord: ruwe tekst ingevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nie odpowiedziało: wstawiono surowy tekst."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence não respondeu: texto bruto inserido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nu a răspuns: a fost inserat textul brut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence не ответил: вставлен исходный текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence neodpovedala: vložený surový text."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ni odgovoril: vstavljeno je surovo besedilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence svarade inte: råtext infogad."
          }
        },
        "uk": {
          "stringUnit": {
