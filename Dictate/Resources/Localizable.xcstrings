    "control suffit, même par-dessus une app en plein écran. fn au choix dans les Réglages.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "control е достатъчен, дори върху приложение на цял екран. fn е опция в Настройки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stačí control, i nad aplikací na celé obrazovce. fn je volba v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "control er nok, også oven på en app i fuld skærm. fn er en mulighed i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "control genügt, auch über einer App im Vollbildmodus. fn ist eine Option in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το control αρκεί, ακόμη και πάνω από εφαρμογή σε πλήρη οθόνη. Το fn είναι επιλογή στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "control is enough, even over a full-screen app. fn is an option in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta con control, incluso sobre una app a pantalla completa. fn es una opción en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Piisab klahvist control, isegi täisekraanil oleva rakenduse kohal. fn on valik seadetes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelkkä control riittää, myös koko näytön apin päällä. fn on valittavissa asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "control suffit, même par-dessus une app en plein écran. fn au choix dans les Réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoljan je control, čak i iznad aplikacije preko cijelog zaslona. fn je opcija u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elég a control, teljes képernyős app fölött is. Az fn a Beállításokban választható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta control, anche sopra un’app a tutto schermo. fn è un’opzione nelle Impostazioni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakanka „control“, net virš programos visame ekrane. „fn“ galima pasirinkti nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pietiek ar control, pat virs pilnekrāna lietotnes. fn ir izvēle iestatījumos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "control biżżejjed, anke fuq app fi skrin sħiħ. fn hija għażla fis-settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "control volstaat, ook boven een app in volledig scherm. fn is een optie in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy control, nawet nad aplikacją na pełnym ekranie. fn to opcja w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta control, mesmo sobre um app em tela cheia. fn é uma opção nos Ajustes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "control este suficient, chiar și peste o aplicație pe tot ecranul. fn este o opțiune în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно control, даже поверх приложения в полноэкранном режиме. fn — вариант в Настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stačí control, aj nad aplikáciou na celej obrazovke. fn je voľba v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolj je control, tudi nad aplikacijo v celozaslonskem načinu. fn je možnost v nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "control räcker, även över en app i helskärm. fn är ett alternativ i Inställningar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Достатньо control, навіть поверх програми на весь екран. fn — варіант у Параметрах."
          }
        }
      }
    },
