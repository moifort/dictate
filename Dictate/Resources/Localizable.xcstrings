    "Le modèle d'Apple Intelligence, sur ce Mac. Rien ne sort de l'ordinateur, aucun compte nécessaire.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделът на Apple Intelligence, на този Mac. Нищо не напуска компютъра, не е нужен акаунт."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Apple Intelligence, na tomto Macu. Nic neopouští počítač, není potřeba žádný účet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence-modellen, på denne Mac. Intet forlader computeren, ingen konto nødvendig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell von Apple Intelligence, auf diesem Mac. Nichts verlässt den Computer, kein Account nötig."
