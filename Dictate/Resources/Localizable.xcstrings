    "Nécessite Claude Code ou l'app Claude connecté à votre abonnement, ou une clé API.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изисква Claude Code или приложението Claude с вход във вашия абонамент, или API ключ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje Claude Code nebo aplikaci Claude přihlášenou k vašemu předplatnému, případně klíč API."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræver Claude Code eller Claude-appen logget ind på dit abonnement, eller en API-nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert Claude Code oder die Claude-App mit angemeldetem Abo oder einen API-Schlüssel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτεί το Claude Code ή την εφαρμογή Claude συνδεδεμένα στη συνδρομή σας, ή ένα κλειδί API."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires Claude Code or the Claude app signed in to your subscription, or an API key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere Claude Code o la app Claude con la sesión de tu suscripción iniciada, o una clave de API."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajab teie tellimusse sisse logitud Claude Code’i või rakendust Claude või API-võtit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaatii Claude Coden tai Claude-apin, joka on kirjautunut tilaukseesi, tai API-avaimen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Claude Code ou l'app Claude connecté à votre abonnement, ou une clé API."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtijeva Claude Code ili aplikaciju Claude prijavljenu na vašu pretplatu, ili API ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetésébe bejelentkezett Claude Code vagy Claude app, illetve API-kulcs szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede Claude Code o l’app Claude connessi al tuo abbonamento, oppure una chiave API."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reikia „Claude Code“ arba programos „Claude“, prisijungusios prie jūsų prenumeratos, arba API rakto."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepieciešams Claude Code vai lietotne Claude, kas pierakstīta jūsu abonementā, vai API atslēga."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeħtieġ Claude Code jew l-app Claude illoggjati fl-abbonament tiegħek, jew ċavetta API."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist Claude Code of de Claude-app, ingelogd op je abonnement, of een API-sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga Claude Code lub aplikacji Claude zalogowanej do Twojej subskrypcji albo klucza API."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer o Claude Code ou o app Claude conectado à sua assinatura, ou uma chave de API."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesită Claude Code sau aplicația Claude autentificată cu abonamentul dvs., ori o cheie API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется Claude Code или приложение Claude с входом по вашей подписке либо API-ключ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje Claude Code alebo aplikáciu Claude prihlásenú k vášmu predplatnému, prípadne kľúč API."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahteva Claude Code ali aplikacijo Claude, prijavljeno v vašo naročnino, ali ključ API."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver Claude Code eller Claude-appen inloggad på ditt abonnemang, eller en API-nyckel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен Claude Code або програма Claude із входом за вашою підпискою чи API-ключ."
          }
        }
      }
    },
    "Ouvrez les Réglages et activez Dictate dans la liste.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете Настройки и включете Dictate в списъка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Nastavení a zapněte Dictate v seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Indstillinger, og slå Dictate til på listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Einstellungen und aktiviere Dictate in der Liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τις Ρυθμίσεις και ενεργοποιήστε το Dictate στη λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings and turn on Dictate in the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes y activa Dictate en la lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avage seaded ja lülitage Dictate loendis sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Asetukset ja laita Dictate päälle luettelossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez les Réglages et activez Dictate dans la liste."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite Postavke i uključite Dictate na popisu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg a Beállításokat, és kapcsolja be a Dictate-et a listában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni e attiva Dictate nell’elenco."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidarykite nustatymus ir sąraše įjunkite „Dictate“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atveriet iestatījumus un sarakstā ieslēdziet Dictate."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iftaħ is-settings u ixgħel Dictate fil-lista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen en schakel Dictate in de lijst in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Ustawienia i włącz Dictate na liście."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra os Ajustes e ative o Dictate na lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Configurări și activați Dictate în listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Настройки и включите Dictate в списке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
