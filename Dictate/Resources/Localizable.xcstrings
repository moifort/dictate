    "Envoie le message une fois le texte collé, seulement dans ces apps :": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпраща съобщението веднага щом текстът бъде поставен, само в тези приложения:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešle zprávu, jakmile je text vložen, pouze v těchto aplikacích:"
          }
        },
        "da": {
          "stringUnit": {
