    "Pour repérer le champ de texte actif et y coller votre dictée. Sans champ actif, le texte reste dans le presse-papiers.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да се намери активното текстово поле и диктовката ви да се постави в него. Без активно поле текстът остава в клипборда."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby bylo možné najít aktivní textové pole a vložit do něj váš diktát. Bez aktivního pole zůstane text ve schránce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at finde det aktive tekstfelt og sætte dit diktat ind i det. Uden et aktivt felt bliver teksten på udklipsholderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um das aktive Textfeld zu finden und dein Diktat dort einzufügen. Ohne aktives Feld bleibt der Text in der Zwischenablage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να βρεθεί το ενεργό πεδίο κειμένου και να επικολληθεί εκεί η υπαγόρευσή σας. Χωρίς ενεργό πεδίο, το κείμενο μένει στο πρόχειρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find the active text field and paste your dictation into it. Without an active field, the text stays on the clipboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrar el campo de texto activo y pegar en él tu dictado. Sin un campo activo, el texto se queda en el portapapeles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiivse tekstivälja leidmiseks ja dikteerimise sinna kleepimiseks. Ilma aktiivse väljata jääb tekst lõikelauale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiivisen tekstikentän löytämiseksi ja sanelusi sijoittamiseksi siihen. Jos aktiivista kenttää ei ole, teksti jää leikepöydälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour repérer le champ de texte actif et y coller votre dictée. Sans champ actif, le texte reste dans le presse-papiers."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pronalaženje aktivnog tekstnog polja i lijepljenje diktata u njega. Bez aktivnog polja tekst ostaje u međuspremniku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aktív szövegmező megtalálásához és a diktálás beillesztéséhez. Aktív mező nélkül a szöveg a vágólapon marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trovare il campo di testo attivo e incollarvi la tua dettatura. Senza un campo attivo, il testo resta negli appunti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad būtų rastas aktyvus teksto laukas ir į jį įklijuotas jūsų diktavimas. Jei aktyvaus lauko nėra, tekstas lieka iškarpinėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai atrastu aktīvo teksta lauku un ielīmētu tajā jūsu diktējumu. Ja aktīva lauka nav, teksts paliek starpliktuvē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Biex tinstab il-kaxxa tat-test attiva u d-dettatura tiegħek titwaħħal fiha. Mingħajr kaxxa attiva, it-test jibqa’ fil-clipboard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om het actieve tekstveld te vinden en je dictaat erin te plakken. Zonder actief veld blijft de tekst op het klembord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby znaleźć aktywne pole tekstowe i wkleić do niego dyktowanie. Bez aktywnego pola tekst pozostaje w schowku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrar o campo de texto ativo e colar seu ditado nele. Sem um campo ativo, o texto fica na área de transferência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a găsi câmpul de text activ și a lipi dictarea în el. Fără un câmp activ, textul rămâne în clipboard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы найти активное текстовое поле и вставить в него диктовку. Без активного поля текст остаётся в буфере обмена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby bolo možné nájsť aktívne textové pole a vložiť doň váš diktát. Bez aktívneho poľa zostane text v schránke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za iskanje aktivnega besedilnega polja in lepljenje nareka vanj. Brez aktivnega polja besedilo ostane v odložišču."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att hitta det aktiva textfältet och klistra in din diktering där. Utan ett aktivt fält stannar texten i urklipp."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб знайти активне текстове поле і вставити в нього диктування. Без активного поля текст залишається в буфері обміну."
          }
        }
      }
    },
