    "Chaque ligne se coche dès que c'est accordé.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки ред се отмята веднага щом разрешението бъде дадено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý řádek se odškrtne, jakmile je oprávnění uděleno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver linje bliver hakket af, så snart tilladelsen er givet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile wird abgehakt, sobald die Erlaubnis erteilt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε γραμμή σημειώνεται μόλις δοθεί η άδεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each line ticks itself as soon as it is granted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada línea se marca en cuanto se concede el permiso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga rida märgitakse kohe, kui luba on antud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen rivi merkitään valmiiksi heti, kun lupa on annettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne se coche dès que c'est accordé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki se redak označi čim se dozvola odobri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden sor kipipálódik, amint az engedély megvan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni riga viene spuntata non appena il permesso è concesso."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekviena eilutė pažymima, kai tik suteikiamas leidimas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katra rinda tiek atzīmēta, tiklīdz atļauja ir piešķirta."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kull linja tiġi mmarkata hekk kif jingħata l-permess."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke regel wordt afgevinkt zodra de toestemming is gegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wiersz zostaje odhaczony, gdy tylko uprawnienie zostanie przyznane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha é marcada assim que a permissão é concedida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare rând se bifează imediat ce permisiunea este acordată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая строка отмечается, как только разрешение выдано."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý riadok sa odškrtne, hneď ako je povolenie udelené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka vrstica se odkljuka, takoj ko je dovoljenje podeljeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje rad bockas av så fort behörigheten har getts."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рядок позначається, щойно дозвіл надано."
          }
        }
      }
    },
