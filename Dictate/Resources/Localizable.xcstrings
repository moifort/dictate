    "Dictée trop longue pour Apple Intelligence.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовката е твърде дълга за Apple Intelligence."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktát je pro Apple Intelligence příliš dlouhý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktatet er for langt til Apple Intelligence."
          }
        },
        "de": {
