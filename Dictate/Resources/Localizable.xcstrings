    "Texte du champ, titre de la fenêtre et domaine du site, pour reprendre vos noms et votre ton. Jamais un mot de passe.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстът на полето, заглавието на прозореца и домейнът на сайта, за да се запазят вашите имена и вашият тон. Никога парола."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text pole, název okna a doména webu, aby se zachovala vaše jména a váš tón. Nikdy heslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Feltets tekst, vinduets titel og webstedets domæne, for at bevare dine navne og din tone. Aldrig en adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text des Feldes, der Fenstertitel und die Domain der Website, um deine Namen und deinen Ton zu bewahren. Niemals ein Passwort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο του πεδίου, ο τίτλος του παραθύρου και ο τομέας του ιστότοπου, για να διατηρούνται τα ονόματά σας και το ύφος σας. Ποτέ συνθηματικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The field's text, the window title and the site's domain, to keep your names and your tone. Never a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del campo, el título de la ventana y el dominio del sitio, para conservar tus nombres y tu tono. Nunca una contraseña."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Välja tekst, akna pealkiri ja saidi domeen, et säiliksid teie nimed ja teie toon. Mitte kunagi parool."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kentän teksti, ikkunan otsikko ja sivuston verkkotunnus, jotta nimesi ja sävysi säilyvät. Ei koskaan salasanaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte du champ, titre de la fenêtre et domaine du site, pour reprendre vos noms et votre ton. Jamais un mot de passe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst polja, naslov prozora i domena stranice, kako bi se zadržala vaša imena i vaš ton. Nikad lozinka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mező szövege, az ablak címe és a webhely domainje, hogy megmaradjanak a nevei és a hangneme. Jelszó soha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo del campo, il titolo della finestra e il dominio del sito, per mantenere i tuoi nomi e il tuo tono. Mai una password."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lauko tekstas, lango pavadinimas ir svetainės domenas, kad būtų išlaikyti jūsų vardai ir jūsų tonas. Slaptažodis – niekada."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lauka teksts, loga nosaukums un vietnes domēns, lai saglabātu jūsu vārdus un jūsu toni. Nekad parole."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-test tal-kaxxa, it-titlu tat-tieqa u d-dominju tas-sit, biex jinżammu l-ismijiet u t-ton tiegħek. Qatt password."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst van het veld, de venstertitel en het domein van de site, om je namen en je toon te behouden. Nooit een wachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst pola, tytuł okna i domena witryny, aby zachować Twoje nazwy i Twój ton. Nigdy hasło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto do campo, o título da janela e o domínio do site, para manter seus nomes e seu tom. Nunca uma senha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul câmpului, titlul ferestrei și domeniul site-ului, pentru a vă păstra numele și tonul. Niciodată o parolă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст поля, заголовок окна и домен сайта — чтобы сохранить ваши имена и ваш тон. Пароли — никогда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text poľa, názov okna a doména stránky, aby sa zachovali vaše mená a váš tón. Nikdy heslo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besedilo polja, naslov okna in domena spletnega mesta, da se ohranijo vaša imena in vaš ton. Nikoli geslo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fältets text, fönstrets titel och webbplatsens domän, för att behålla dina namn och din ton. Aldrig ett lösenord."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст поля, заголовок вікна й домен сайту — щоб зберегти ваші імена та ваш тон. Паролі — ніколи."
          }
        }
      }
    },
