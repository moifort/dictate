        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude usage limit reached: try again once it resets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de uso de Claude alcanzado: inténtalo de nuevo cuando se restablezca."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude’i kasutuslimiit on täis: proovige uuesti, kui see on lähtestatud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clauden käyttöraja saavutettu: yritä uudelleen, kun se on nollautunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite d'utilisation de Claude atteinte : réessayez après sa réinitialisation."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosegnuto ograničenje korištenja Claudea: pokušajte ponovno nakon što se poništi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elérte a Claude használati korlátját: próbálja újra, amint visszaáll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di utilizzo di Claude raggiunto: riprova dopo il ripristino."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasiektas „Claude“ naudojimo limitas: bandykite dar kartą, kai jis bus atkurtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
