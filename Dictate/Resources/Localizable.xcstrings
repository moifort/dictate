    },
    "Cliquez dans le champ, maintenez %@, parlez, relâchez, puis collez avec ⌘V.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Щракнете в полето, задръжте %@, говорете, пуснете и поставете с ⌘V."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte do pole, podržte %@, mluvte, uvolněte a vložte pomocí ⌘V."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik i feltet, hold %@ nede, tal, slip, og sæt ind med ⌘V."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in das Feld, halte %@ gedrückt, sprich, lass los und füge mit ⌘V ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο πεδίο, κρατήστε πατημένο το %@, μιλήστε, αφήστε και επικολλήστε με ⌘V."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click in the field, hold %@, speak, release, then paste with ⌘V."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el campo, mantén pulsado %@, habla, suelta y pega con ⌘V."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klõpsake väljal, hoidke all %@, rääkige, vabastage ja kleepige klahvidega ⌘V."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikkaa kenttää, pidä %@ painettuna, puhu, vapauta ja sijoita painamalla ⌘V."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez dans le champ, maintenez %@, parlez, relâchez, puis collez avec ⌘V."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite u polje, držite %@, govorite, otpustite pa zalijepite s ⌘V."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson a mezőbe, tartsa lenyomva: %@, beszéljen, engedje fel, majd illessze be a ⌘V billentyűkombinációval."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic nel campo, tieni premuto %@, parla, rilascia, poi incolla con ⌘V."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustelėkite lauke, laikykite nuspaudę %@, kalbėkite, atleiskite ir įklijuokite paspaudę ⌘V."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noklikšķiniet laukā, turiet nospiestu %@, runājiet, atlaidiet un ielīmējiet ar ⌘V."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikklikkja fil-kaxxa, żomm %@ magħfus, tkellem, itlaq, imbagħad waħħal b’⌘V."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik in het veld, houd %@ ingedrukt, spreek, laat los en plak met ⌘V."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij w pole, przytrzymaj %@, mów, puść, a następnie wklej, naciskając ⌘V."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no campo, mantenha %@ pressionado, fale, solte e cole com ⌘V."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic în câmp, țineți apăsat %@, vorbiți, eliberați, apoi lipiți cu ⌘V."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите в поле, удерживайте %@, говорите, отпустите, затем вставьте с помощью ⌘V."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite do poľa, podržte %@, hovorte, pustite a vložte pomocou ⌘V."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite v polje, držite %@, govorite, spustite in prilepite z ⌘V."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka i fältet, håll ned %@, tala, släpp och klistra in med ⌘V."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть у полі, утримуйте %@, говоріть, відпустіть, а потім вставте за допомогою ⌘V."
          }
        }
      }
    },
