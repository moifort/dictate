    "Claude n'a pas répondu : texte brut inséré.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не отговори: вмъкнат е суровият текст."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude neodpověděl: vložen surový text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude svarede ikke: rå tekst indsat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude hat nicht geantwortet: Rohtext eingefügt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Claude δεν απάντησε: εισήχθη το ακατέργαστο κείμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude did not answer: raw text inserted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude no ha respondido: se ha insertado el texto sin revisar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ei vastanud: sisestati toortekst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ei vastannut: raakateksti lisätty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude n'a pas répondu : texte brut inséré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nije odgovorio: umetnut je neobrađeni tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Claude nem válaszolt: a nyers szöveg lett beszúrva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude non ha risposto: inserito il testo grezzo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Claude“ neatsakė: įterptas neapdorotas tekstas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude neatbildēja: ievietots neapstrādāts teksts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ma weġibx: iddaħħal it-test mhux maħdum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude heeft niet geantwoord: ruwe tekst ingevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nie odpowiedział: wstawiono surowy tekst."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude não respondeu: texto bruto inserido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nu a răspuns: a fost inserat textul brut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не ответил: вставлен исходный текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude neodpovedal: vložený surový text."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ni odgovoril: vstavljeno je surovo besedilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude svarade inte: råtext infogad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не відповів: вставлено сирий текст."
          }
        }
      }
    },
    "Claude n'est connecté à aucun compte : Apple Intelligence relit sur ce Mac. Connectez-vous à Claude pour qu'il prenne le relais.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не е влязъл в нито един акаунт: на този Mac преглежда Apple Intelligence. Влезте в Claude, за да поеме той."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude není přihlášen k žádnému účtu: na tomto Macu kontroluje Apple Intelligence. Přihlaste se do Claude, aby kontrolu převzal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude er ikke logget ind på nogen konto: Apple Intelligence gennemgår på denne Mac. Log ind på Claude, så tager den over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ist bei keinem Account angemeldet: Apple Intelligence korrigiert auf diesem Mac. Melde dich bei Claude an, damit es übernimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Claude δεν είναι συνδεδεμένο σε κανέναν λογαριασμό: το Apple Intelligence ελέγχει σε αυτό το Mac. Συνδεθείτε στο Claude για να αναλάβει εκείνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude is not signed in to any account: Apple Intelligence reviews on this Mac. Sign in to Claude for it to take over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude no tiene sesión iniciada en ninguna cuenta: Apple Intelligence revisa en este Mac. Inicia sesión en Claude para que tome el relevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude pole ühelegi kontole sisse logitud: selles Macis vaatab üle Apple Intelligence. Logige Claude’i sisse, et see töö üle võtaks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ei ole kirjautunut millekään tilille: Apple Intelligence tarkistaa tällä Macilla. Kirjaudu Claudeen, niin se ottaa tehtävän hoitaakseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude n'est connecté à aucun compte : Apple Intelligence relit sur ce Mac. Connectez-vous à Claude pour qu'il prenne le relais."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nije prijavljen ni na jedan račun: na ovom Macu pregledava Apple Intelligence. Prijavite se u Claude da on preuzme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Claude egyetlen fiókba sincs bejelentkezve: az Apple Intelligence ellenőriz ezen a Macen. Jelentkezzen be a Claude-ba, hogy átvegye."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude non è connesso ad alcun account: Apple Intelligence rilegge su questo Mac. Accedi a Claude perché subentri."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Claude“ neprisijungęs prie jokios paskyros: šiame „Mac“ peržiūri „Apple Intelligence“. Prisijunkite prie „Claude“, kad jis perimtų darbą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nav pierakstījies nevienā kontā: šajā Mac datorā pārskata Apple Intelligence. Pierakstieties Claude, lai tas pārņemtu darbu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude mhux illoggjat f’ebda kont: Apple Intelligence jirrevedi fuq dan il-Mac. Illoggja f’Claude biex jieħu f’idejh hu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude is bij geen enkel account ingelogd: Apple Intelligence kijkt na op deze Mac. Log in bij Claude om het te laten overnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nie jest zalogowany na żadnym koncie: Apple Intelligence sprawdza na tym Macu. Zaloguj się w Claude, aby przejął to zadanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude não está conectado a nenhuma conta: a Apple Intelligence revisa neste Mac. Inicie sessão no Claude para que ele assuma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nu este autentificat în niciun cont: Apple Intelligence revizuiește pe acest Mac. Autentificați-vă în Claude ca să preia el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не вошёл ни в одну учётную запись: на этом Mac проверяет Apple Intelligence. Войдите в Claude, чтобы он взял проверку на себя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nie je prihlásený do žiadneho účtu: na tomto Macu kontroluje Apple Intelligence. Prihláste sa do Claude, aby kontrolu prevzal."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ni prijavljen v noben račun: na tem Macu pregleduje Apple Intelligence. Prijavite se v Claude, da prevzame."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude är inte inloggad på något konto: Apple Intelligence granskar på den här datorn. Logga in på Claude så tar det över."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не ввійшов до жодного облікового запису: на цьому Mac перевіряє Apple Intelligence. Увійдіть у Claude, щоб він узяв перевірку на себе."
          }
        }
      }
    },
