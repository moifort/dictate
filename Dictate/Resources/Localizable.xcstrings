    "Modèle GPT-5.4 nano sans raisonnement, le plus rapide d'OpenAI, via votre clé API.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano без разсъждение, най-бързият модел на OpenAI, чрез вашия API ключ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano bez uvažování, nejrychlejší model OpenAI, přes váš klíč API."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano uden ræsonnement, OpenAI’s hurtigste model, via din API-nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano ohne Reasoning, das schnellste Modell von OpenAI, über deinen API-Schlüssel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano χωρίς συλλογισμό, το ταχύτερο μοντέλο της OpenAI, μέσω του κλειδιού API σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano without reasoning, OpenAI's fastest model, through your API key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano sin razonamiento, el modelo más rápido de OpenAI, con tu clave de API."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano ilma arutluseta, OpenAI kiireim mudel, teie API-võtme kaudu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano ilman päättelyä, OpenAI:n nopein malli, API-avaimesi kautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle GPT-5.4 nano sans raisonnement, le plus rapide d'OpenAI, via votre clé API."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano bez zaključivanja, najbrži model OpenAI-ja, putem vašeg API ključa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano érvelés nélkül, az OpenAI leggyorsabb modellje, az Ön API-kulcsán keresztül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano senza ragionamento, il modello più veloce di OpenAI, tramite la tua chiave API."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„GPT-5.4 nano“ be samprotavimo, greičiausias „OpenAI“ modelis, per jūsų API raktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano bez spriešanas, OpenAI ātrākais modelis, ar jūsu API atslēgu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano mingħajr raġunament, l-aktar mudell veloċi ta’ OpenAI, permezz taċ-ċavetta API tiegħek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.4 nano zonder redeneren, het snelste model van OpenAI, via je API-sleutel."
          }
        },
        "pl": {
