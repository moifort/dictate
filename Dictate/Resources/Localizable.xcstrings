          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybór automatyczny: Claude, w przeciwnym razie OpenAI, potem Gemini, potem Apple Intelligence, zależnie od tego, co zostanie wykryte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha automática: Claude, senão OpenAI, senão Gemini, senão Apple Intelligence, conforme o que for detectado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegere automată: Claude, altfel OpenAI, altfel Gemini, altfel Apple Intelligence, în funcție de ce este detectat."
          }
        },
        "ru": {
