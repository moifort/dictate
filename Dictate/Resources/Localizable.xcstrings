        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-mudell jaħdem lokalment. Leħnek qatt ma joħroġ mill-kompjuter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model draait lokaal. Je stem verlaat de computer nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model działa lokalnie. Twój głos nigdy nie opuszcza komputera."
          }
        },
        "pt": {
