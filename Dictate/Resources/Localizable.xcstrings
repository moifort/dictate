    "Conserve sur ce Mac l'audio, la transcription, le texte inséré et le contenu du champ %lld s plus tard, vos corrections comprises. Rien n'est envoyé.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пази на този Mac аудиото, транскрипцията, вмъкнатия текст и съдържанието на полето %lld с по-късно, заедно с вашите поправки. Нищо не се изпраща."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovává na tomto Macu zvuk, přepis, vložený text a obsah pole o %lld s později, včetně vašich oprav. Nic se neodesílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer lyden, transskriptionen, den indsatte tekst og feltets indhold %lld s senere på denne Mac, inklusive dine rettelser. Intet bliver sendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert auf diesem Mac das Audio, das Transkript, den eingefügten Text und den Inhalt des Feldes %lld s später, einschließlich deiner Korrekturen. Nichts wird gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρεί σε αυτό το Mac τον ήχο, τη μεταγραφή, το κείμενο που εισήχθη και το περιεχόμενο του πεδίου %lld δ. αργότερα, μαζί με τις διορθώσεις σας. Δεν αποστέλλεται τίποτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps on this Mac the audio, the transcript, the inserted text and the field's content %lld s later, your fixes included. Nothing is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en este Mac el audio, la transcripción, el texto insertado y el contenido del campo %lld s después, con tus correcciones. No se envía nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab selles Macis heli, transkriptsiooni, sisestatud teksti ja välja sisu %lld s hiljem, koos teie parandustega. Midagi ei saadeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilyttää tällä Macilla äänen, litteroinnin, lisätyn tekstin ja kentän sisällön %lld s myöhemmin, korjauksesi mukaan lukien. Mitään ei lähetetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve sur ce Mac l'audio, la transcription, le texte inséré et le contenu du champ %lld s plus tard, vos corrections comprises. Rien n'est envoyé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čuva na ovom Macu zvuk, transkript, umetnuti tekst i sadržaj polja %lld s kasnije, uključujući vaše ispravke. Ništa se ne šalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a Macen megőrzi a hangot, az átiratot, a beszúrt szöveget és a mező tartalmát %lld mp-cel később, az Ön javításaival együtt. Semmi sem kerül elküldésre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva su questo Mac l’audio, la trascrizione, il testo inserito e il contenuto del campo %lld s dopo, correzioni comprese. Non viene inviato nulla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame „Mac“ saugo garsą, transkripciją, įterptą tekstą ir lauko turinį po %lld s, įskaitant jūsų pataisymus. Niekas nesiunčiama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā Mac datorā glabā audio, transkripciju, ievietoto tekstu un lauka saturu pēc %lld s, ieskaitot jūsu labojumus. Nekas netiek nosūtīts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iżomm fuq dan il-Mac l-awdjo, it-traskrizzjoni, it-test imdaħħal u l-kontenut tal-kaxxa %lld s wara, inklużi l-korrezzjonijiet tiegħek. Ma jintbagħat xejn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart op deze Mac de audio, het transcript, de ingevoegde tekst en de inhoud van het veld %lld s later, inclusief je correcties. Er wordt niets verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje na tym Macu dźwięk, transkrypcję, wstawiony tekst i zawartość pola %lld s później, łącznie z Twoimi poprawkami. Nic nie jest wysyłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda neste Mac o áudio, a transcrição, o texto inserido e o conteúdo do campo %lld s depois, incluindo suas correções. Nada é enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează pe acest Mac sunetul, transcrierea, textul inserat și conținutul câmpului %lld s mai târziu, inclusiv corecturile dvs. Nimic nu este trimis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранит на этом Mac аудио, расшифровку, вставленный текст и содержимое поля через %lld с, включая ваши исправления. Ничего не отправляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchováva na tomto Macu zvuk, prepis, vložený text a obsah poľa o %lld s neskôr vrátane vašich opráv. Nič sa neodosiela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tem Macu hrani zvok, prepis, vstavljeno besedilo in vsebino polja %lld s pozneje, skupaj z vašimi popravki. Nič se ne pošlje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar ljudet, transkriptionen, den infogade texten och fältets innehåll %lld s senare på den här datorn, inklusive dina rättelser. Ingenting skickas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає на цьому Mac аудіо, транскрипцію, вставлений текст і вміст поля через %lld с, разом із вашими виправленнями. Нічого не надсилається."
          }
        }
      }
    },
