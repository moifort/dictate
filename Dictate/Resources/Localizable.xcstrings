    " Apple Intelligence prend le relais hors ligne.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": " Офлайн работата поема Apple Intelligence."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": " Offline ji zastoupí Apple Intelligence."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": " Apple Intelligence tager over offline."
          }
        },
        "de": {
          "stringUnit": {
