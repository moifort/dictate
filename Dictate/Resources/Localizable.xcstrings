        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää viestin heti, kun teksti on sijoitettu, vain näissä apeissa:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie le message une fois le texte collé, seulement dans ces apps :"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje poruku čim se tekst zalijepi, samo u ovim aplikacijama:"
