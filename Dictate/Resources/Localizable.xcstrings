        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте клавішу диктування й говоріть: тут з’явиться ваша статистика."
          }
        }
      }
    },
    "Maintenez option + espace pour dicter, puis collez le texte avec ⌘V. Sur un clavier français, option + espace tape aussi l'espace insécable : préférez alors control + option + espace.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръжте option + интервал, за да диктувате, след това поставете текста с ⌘V. На френска клавиатура option + интервал въвежда и непрекъсваем интервал: по-добре изберете control + option + интервал."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro diktování podržte option + mezerník a pak text vložte pomocí ⌘V. Na francouzské klávesnici píše option + mezerník také nedělitelnou mezeru: zvolte raději control + option + mezerník."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold option + mellemrum nede for at diktere, og sæt derefter teksten ind med ⌘V. På et fransk tastatur skriver option + mellemrum også et hårdt mellemrum: vælg hellere control + option + mellemrum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte option + Leertaste gedrückt, um zu diktieren, und füge den Text dann mit ⌘V ein. Auf einer französischen Tastatur erzeugt option + Leertaste auch das geschützte Leerzeichen: Wähle stattdessen control + option + Leertaste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε πατημένα option + διάστημα για υπαγόρευση και μετά επικολλήστε το κείμενο με ⌘V. Σε γαλλικό πληκτρολόγιο, το option + διάστημα πληκτρολογεί επίσης το αδιάσπαστο διάστημα: προτιμήστε control + option + διάστημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold option + space to dictate, then paste the text with ⌘V. On a French keyboard, option + space also types the non-breaking space: pick control + option + space instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado opción + espacio para dictar y luego pega el texto con ⌘V. En un teclado francés, opción + espacio también escribe el espacio de no separación: elige mejor control + opción + espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimiseks hoidke all option + tühik, seejärel kleepige tekst klahvidega ⌘V. Prantsuse klaviatuuril sisestab option + tühik ka sisetühiku: valige pigem control + option + tühik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanele pitämällä optio + välilyönti painettuna ja sijoita teksti sitten painamalla ⌘V. Ranskalaisella näppäimistöllä optio + välilyönti kirjoittaa myös sitovan välilyönnin: valitse mieluummin control + optio + välilyönti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez option + espace pour dicter, puis collez le texte avec ⌘V. Sur un clavier français, option + espace tape aussi l'espace insécable : préférez alors control + option + espace."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite option + razmaknicu za diktiranje, zatim zalijepite tekst s ⌘V. Na francuskoj tipkovnici option + razmaknica upisuje i neprelomljivi razmak: radije odaberite control + option + razmaknicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktáláshoz tartsa lenyomva az option + szóköz billentyűket, majd illessze be a szöveget a ⌘V billentyűkombinációval. Francia billentyűzeten az option + szóköz a nem törhető szóközt is beírja: válassza inkább a control + option + szóköz kombinációt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto opzione + spazio per dettare, poi incolla il testo con ⌘V. Su una tastiera francese, opzione + spazio inserisce anche lo spazio unificatore: scegli piuttosto control + opzione + spazio."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami diktuoti, laikykite nuspaudę „option“ + tarpo klavišą, tada įklijuokite tekstą paspaudę ⌘V. Prancūziškoje klaviatūroje „option“ + tarpo klavišas taip pat įveda jungiamąjį tarpą: verčiau rinkitės „control“ + „option“ + tarpo klavišą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai diktētu, turiet nospiestu option + atstarpi, pēc tam ielīmējiet tekstu ar ⌘V. Uz franču tastatūras option + atstarpe ievada arī nedalāmo atstarpi: labāk izvēlieties control + option + atstarpi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żomm option + spazju magħfusin biex tiddetta, imbagħad waħħal it-test b’⌘V. Fuq tastiera Franċiża, option + spazju jikteb ukoll l-ispazju li ma jinqasamx: aħjar agħżel control + option + spazju."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd option + spatie ingedrukt om te dicteren en plak de tekst daarna met ⌘V. Op een Frans toetsenbord typt option + spatie ook de harde spatie: kies liever control + option + spatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj option + spację, aby dyktować, a następnie wklej tekst, naciskając ⌘V. Na klawiaturze francuskiej option + spacja wpisuje też spację nierozdzielającą: wybierz raczej control + option + spację."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha option + espaço pressionados para ditar e depois cole o texto com ⌘V. Em um teclado francês, option + espaço também digita o espaço inseparável: prefira control + option + espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți apăsat opțiune + spațiu pentru a dicta, apoi lipiți textul cu ⌘V. Pe o tastatură franceză, opțiune + spațiu scrie și spațiul neseparator: alegeți mai bine control + opțiune + spațiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте option + пробел, чтобы диктовать, затем вставьте текст с помощью ⌘V. На французской клавиатуре option + пробел также вводит неразрывный пробел: лучше выберите control + option + пробел."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na diktovanie podržte option + medzerník a potom text vložte pomocou ⌘V. Na francúzskej klávesnici píše option + medzerník aj nedeliteľnú medzeru: zvoľte radšej control + option + medzerník."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za narekovanje držite option + preslednico, nato besedilo prilepite z ⌘V. Na francoski tipkovnici option + preslednica vnese tudi nedeljivi presledek: raje izberite control + option + preslednico."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned option + mellanslag för att diktera och klistra sedan in texten med ⌘V. På ett franskt tangentbord skriver option + mellanslag också ett hårt blanksteg: välj hellre control + option + mellanslag."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте option + пробіл, щоб диктувати, а потім вставте текст за допомогою ⌘V. На французькій клавіатурі option + пробіл також уводить нерозривний пробіл: краще виберіть control + option + пробіл."
          }
        }
      }
    },
    "Maintenez option + espace, parlez, relâchez : le texte est dans le presse-papiers, prêt à coller dans n'importe quelle app.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръжте option + интервал, говорете, пуснете: текстът е в клипборда, готов за поставяне във всяко приложение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte option + mezerník, mluvte, uvolněte: text je ve schránce, připravený k vložení do jakékoli aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold option + mellemrum nede, tal, slip: teksten ligger på udklipsholderen, klar til at blive sat ind i enhver app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte option + Leertaste gedrückt, sprich, lass los: Der Text liegt in der Zwischenablage, bereit zum Einfügen in jede App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε πατημένα option + διάστημα, μιλήστε, αφήστε: το κείμενο βρίσκεται στο πρόχειρο, έτοιμο για επικόλληση σε οποιαδήποτε εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold option + space, speak, release: the text is on the clipboard, ready to paste into any app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado opción + espacio, habla, suelta: el texto está en el portapapeles, listo para pegar en cualquier app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoidke all option + tühik, rääkige, vabastage: tekst on lõikelaual, valmis kleepimiseks mis tahes rakendusse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä optio + välilyönti painettuna, puhu, vapauta: teksti on leikepöydällä valmiina sijoitettavaksi mihin tahansa appiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez option + espace, parlez, relâchez : le texte est dans le presse-papiers, prêt à coller dans n'importe quelle app."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite option + razmaknicu, govorite, otpustite: tekst je u međuspremniku, spreman za lijepljenje u bilo koju aplikaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa lenyomva az option + szóköz billentyűket, beszéljen, engedje fel: a szöveg a vágólapon van, bármely appba beilleszthető."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto opzione + spazio, parla, rilascia: il testo è negli appunti, pronto da incollare in qualsiasi app."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikykite nuspaudę „option“ + tarpo klavišą, kalbėkite, atleiskite: tekstas yra iškarpinėje, paruoštas įklijuoti į bet kurią programą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turiet nospiestu option + atstarpi, runājiet, atlaidiet: teksts ir starpliktuvē, gatavs ielīmēšanai jebkurā lietotnē."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żomm option + spazju magħfusin, tkellem, itlaq: it-test qiegħed fil-clipboard, lest biex jitwaħħal f’kull app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd option + spatie ingedrukt, spreek, laat los: de tekst staat op het klembord, klaar om in elke app te plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj option + spację, mów, puść: tekst jest w schowku, gotowy do wklejenia w dowolnej aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha option + espaço pressionados, fale, solte: o texto está na área de transferência, pronto para colar em qualquer app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți apăsat opțiune + spațiu, vorbiți, eliberați: textul este în clipboard, gata de lipit în orice aplicație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте option + пробел, говорите, отпустите: текст в буфере обмена, готов к вставке в любое приложение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte option + medzerník, hovorte, pustite: text je v schránke, pripravený na vloženie do ktorejkoľvek aplikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite option + preslednico, govorite, spustite: besedilo je v odložišču, pripravljeno za lepljenje v katero koli aplikacijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned option + mellanslag, tala, släpp: texten finns i urklipp, redo att klistras in i vilken app som helst."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте option + пробіл, говоріть, відпустіть: текст у буфері обміну, готовий до вставлення в будь-яку програму."
          }
        }
      }
    },
    "Maintenez 🌐 fn pour dicter. macOS doit la laisser libre : Clavier → « Appuyer sur la touche 🌐 pour » → « Ne rien faire ».": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръжте 🌐 fn, за да диктувате. macOS трябва да остави клавиша свободен: Клавиатура → „Натиснете клавиша 🌐 за“ → „Не прави нищо“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro diktování podržte 🌐 fn. macOS musí klávesu nechat volnou: Klávesnice → „Stisknutí klávesy 🌐“ → „Nedělat nic“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold 🌐 fn nede for at diktere. macOS skal lade tasten være fri: Tastatur → “Tryk på 🌐-tasten for at” → “Gør intet”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte 🌐 fn gedrückt, um zu diktieren. macOS muss die Taste freilassen: Tastatur → „Drücken der 🌐-Taste“ → „Keine Aktion“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε πατημένο το 🌐 fn για υπαγόρευση. Το macOS πρέπει να το αφήσει ελεύθερο: Πληκτρολόγιο → «Πάτημα πλήκτρου 🌐 για» → «Καμία ενέργεια»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold 🌐 fn to dictate. macOS must leave it free: Keyboard → “Press 🌐 key to” → “Do Nothing”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado 🌐 fn para dictar. macOS debe dejarla libre: Teclado → «Al pulsar la tecla 🌐» → «No hacer nada»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimiseks hoidke all 🌐 fn. macOS peab klahvi vabaks jätma: Keyboard → „Press 🌐 key to“ → „Do Nothing“."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanele pitämällä 🌐 fn painettuna. macOS:n on jätettävä näppäin vapaaksi: Näppäimistö → ”Paina 🌐-näppäintä:” → ”Älä tee mitään”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez 🌐 fn pour dicter. macOS doit la laisser libre : Clavier → « Appuyer sur la touche 🌐 pour » → « Ne rien faire »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite 🌐 fn za diktiranje. macOS mora ostaviti tipku slobodnom: Tipkovnica → „Pritisnite tipku 🌐 za” → „Ne čini ništa”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktáláshoz tartsa lenyomva a 🌐 fn billentyűt. A macOS-nek szabadon kell hagynia: Billentyűzet → „A 🌐 billentyű megnyomásakor” → „Ne történjen semmi”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto 🌐 fn per dettare. macOS deve lasciarlo libero: Tastiera → “Premi il tasto 🌐 per” → “Nessuna azione”."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami diktuoti, laikykite nuspaudę 🌐 fn. „macOS“ turi palikti klavišą laisvą: „Keyboard“ → „Press 🌐 key to“ → „Do Nothing“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai diktētu, turiet nospiestu 🌐 fn. macOS ir jāatstāj taustiņš brīvs: Keyboard → “Press 🌐 key to” → “Do Nothing”."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żomm 🌐 fn magħfus biex tiddetta. macOS irid iħalli t-tasta ħielsa: Keyboard → “Press 🌐 key to” → “Do Nothing”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd 🌐 fn ingedrukt om te dicteren. macOS moet de toets vrijlaten: Toetsenbord → ‘Druk op 🌐-toets voor’ → ‘Doe niets’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj 🌐 fn, aby dyktować. macOS musi zostawić ten klawisz wolny: Klawiatura → „Naciśnięcie klawisza 🌐” → „Nic nie rób”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha 🌐 fn pressionado para ditar. O macOS precisa deixá-la livre: Teclado → “Pressione a tecla 🌐 para” → “Não Fazer Nada”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți apăsat 🌐 fn pentru a dicta. macOS trebuie să lase tasta liberă: Tastatură → „Apăsați tasta 🌐 pentru” → „Nicio acțiune”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте 🌐 fn, чтобы диктовать. macOS должна оставить клавишу свободной: Клавиатура → «Нажатие клавиши 🌐» → «Ничего не делать»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na diktovanie podržte 🌐 fn. macOS musí nechať kláves voľný: Klávesnica → „Stlačenie klávesu 🌐“ → „Nerobiť nič“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za narekovanje držite 🌐 fn. macOS mora tipko pustiti prosto: Keyboard → »Press 🌐 key to« → »Do Nothing«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned 🌐 fn för att diktera. macOS måste lämna tangenten fri: Tangentbord → ”Tryck på 🌐-tangenten för att” → ”Gör ingenting”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте 🌐 fn, щоб диктувати. macOS має залишити клавішу вільною: Клавіатура → «Натискання клавіші 🌐» → «Нічого не робити»."
          }
        }
      }
    },
    "Met l'application, les modèles et les statistiques à la Corbeille, efface les réglages.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Премества приложението, моделите и статистиката в кошчето и изтрива настройките."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesune aplikaci, modely a statistiky do koše a smaže nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytter appen, modellerne og statistikken til papirkurven og sletter indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die App, die Modelle und die Statistiken in den Papierkorb und löscht die Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφέρει την εφαρμογή, τα μοντέλα και τα στατιστικά στον Κάδο και σβήνει τις ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves the app, the models and the statistics to the Trash, erases the settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traslada la app, los modelos y las estadísticas a la papelera y borra los ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teisaldab rakenduse, mudelid ja statistika prügikasti ning kustutab seaded."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtää apin, mallit ja tilastot roskakoriin ja poistaa asetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met l'application, les modèles et les statistiques à la Corbeille, efface les réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premješta aplikaciju, modele i statistiku u Smeće te briše postavke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appot, a modelleket és a statisztikákat a Kukába helyezi, a beállításokat törli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta l’app, i modelli e le statistiche nel Cestino e cancella le impostazioni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkelia programą, modelius ir statistiką į šiukšlinę ir ištrina nustatymus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārvieto lietotni, modeļus un statistiku uz miskasti un izdzēš iestatījumus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imexxi l-app, il-mudelli u l-istatistika fit-Trash u jħassar is-settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatst de app, de modellen en de statistieken naar de prullenmand en wist de instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenosi aplikację, modele i statystyki do Kosza oraz wymazuje ustawienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o app, os modelos e as estatísticas para o Lixo e apaga os ajustes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mută aplicația, modelele și statisticile în coș și șterge configurările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещает приложение, модели и статистику в Корзину и стирает настройки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presunie aplikáciu, modely a štatistiky do koša a vymaže nastavenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Premakne aplikacijo, modele in statistiko v koš ter izbriše nastavitve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttar appen, modellerna och statistiken till papperskorgen och raderar inställningarna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переміщує програму, моделі та статистику до Смітника і стирає параметри."
