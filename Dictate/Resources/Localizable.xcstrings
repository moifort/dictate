    "Claude est déconnecté : lancez « claude auth login » dans un terminal.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude е излязъл от профила: изпълнете „claude auth login“ в терминал."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude je odhlášen: spusťte v terminálu „claude auth login“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude er logget ud: kør “claude auth login” i en terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ist abgemeldet: Führe „claude auth login“ in einem Terminal aus."
          }
