    "GitHub ne répond pas pour le moment (erreur %lld). Réessayez plus tard.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub не отговаря в момента (грешка %lld). Опитайте отново по-късно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub teď neodpovídá (chyba %lld). Zkuste to později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub svarer ikke lige nu (fejl %lld). Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub antwortet gerade nicht (Fehler %lld). Versuche es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GitHub δεν αποκρίνεται αυτήν τη στιγμή (σφάλμα %lld). Δοκιμάστε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub is not responding right now (error %lld). Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no responde en este momento (error %lld). Inténtalo más tarde."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ei vasta praegu (viga %lld). Proovige hiljem uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ei vastaa juuri nyt (virhe %lld). Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ne répond pas pour le moment (erreur %lld). Réessayez plus tard."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub trenutačno ne odgovara (greška %lld). Pokušajte ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub jelenleg nem válaszol (hiba: %lld). Próbálja újra később."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub non risponde in questo momento (errore %lld). Riprova più tardi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„GitHub“ šiuo metu neatsako (klaida %lld). Bandykite vėliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub pašlaik neatbild (kļūda %lld). Mēģiniet vēlāk."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub mhux qed iwieġeb bħalissa (żball %lld). Erġa’ pprova aktar tard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub reageert momenteel niet (fout %lld). Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub w tej chwili nie odpowiada (błąd %lld). Spróbuj ponownie później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não está respondendo no momento (erro %lld). Tente novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nu răspunde în acest moment (eroarea %lld). Încercați din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub сейчас не отвечает (ошибка %lld). Повторите попытку позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub teraz neodpovedá (chyba %lld). Skúste to neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub se trenutno ne odziva (napaka %lld). Poskusite znova pozneje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub svarar inte just nu (fel %lld). Försök igen senare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub зараз не відповідає (помилка %lld). Спробуйте пізніше."
          }
        }
      }
    },
