          "stringUnit": {
            "state": "translated",
            "value": "Aucune app : Entrée n'est jamais pressée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema aplikacije: Return se nikad ne pritišće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs app: a Return soha nincs megnyomva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app: Invio non viene mai premuto."
          }
        },
        "lt": {
          "stringUnit": {
