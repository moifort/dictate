          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka ni izvršljiva: uporablja se samodejno zaznavanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen är inte körbar: automatisk identifiering används."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не є виконуваним: використовується автоматичне визначення."
          }
        }
      }
    },
    "Garder les dictées pour mesurer la précision": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазване на диктовките за измерване на точността"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovávat diktáty pro měření přesnosti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold diktater for at måle nøjagtigheden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktate aufbewahren, um die Genauigkeit zu messen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
