          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jibgħat il-messaġġ hekk kif jitwaħħal it-test, f’dawn l-apps biss:"
          }
        },
        "nl": {
          "stringUnit": {
