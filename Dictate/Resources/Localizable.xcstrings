    "L'API %@ n'a pas répondu : texte brut inséré.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "API на %@ не отговори: вмъкнат е суровият текст."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "API %@ neodpovědělo: vložen surový text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-API’et svarede ikke: rå tekst indsat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %@-API hat nicht geantwortet: Rohtext eingefügt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το API %@ δεν απάντησε: εισήχθη το ακατέργαστο κείμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ API did not answer: raw text inserted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La API de %@ no ha respondido: se ha insertado el texto sin revisar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API ei vastanud: sisestati toortekst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:n API ei vastannut: raakateksti lisätty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'API %@ n'a pas répondu : texte brut inséré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "API %@ nije odgovorio: umetnut je neobrađeni tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ API nem válaszolt: a nyers szöveg lett beszúrva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’API %@ non ha risposto: inserito il testo grezzo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API neatsakė: įterptas neapdorotas tekstas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API neatbildēja: ievietots neapstrādāts teksts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-API %@ ma weġibx: iddaħħal it-test mhux maħdum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %@-API heeft niet geantwoord: ruwe tekst ingevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "API %@ nie odpowiedziało: wstawiono surowy tekst."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A API %@ não respondeu: texto bruto inserido."
          }
        },
        "ro": {
