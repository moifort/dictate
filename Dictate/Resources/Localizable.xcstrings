            "state": "translated",
            "value": "O modelo roda localmente. Sua voz nunca sai do computador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul rulează local. Vocea dvs. nu părăsește niciodată computerul."
          }
