    "Claude est introuvable : Apple Intelligence relit sur ce Mac. Installez Claude pour qu'il prenne le relais.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не е открит: на този Mac преглежда Apple Intelligence. Инсталирайте Claude, за да поеме той."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nebyl nalezen: na tomto Macu kontroluje Apple Intelligence. Nainstalujte Claude, aby kontrolu převzal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude blev ikke fundet: Apple Intelligence gennemgår på denne Mac. Installer Claude, så tager den over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude wurde nicht gefunden: Apple Intelligence korrigiert auf diesem Mac. Installiere Claude, damit es übernimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Claude δεν βρέθηκε: το Apple Intelligence ελέγχει σε αυτό το Mac. Εγκαταστήστε το Claude για να αναλάβει εκείνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude was not found: Apple Intelligence reviews on this Mac. Install Claude to have it take over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado Claude: Apple Intelligence revisa en este Mac. Instala Claude para que tome el relevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude’i ei leitud: selles Macis vaatab üle Apple Intelligence. Installige Claude, et see töö üle võtaks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudea ei löytynyt: Apple Intelligence tarkistaa tällä Macilla. Asenna Claude, niin se ottaa tehtävän hoitaakseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude est introuvable : Apple Intelligence relit sur ce Mac. Installez Claude pour qu'il prenne le relais."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nije pronađen: na ovom Macu pregledava Apple Intelligence. Instalirajte Claude da on preuzme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Claude nem található: az Apple Intelligence ellenőriz ezen a Macen. Telepítse a Claude-ot, hogy átvegye."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude non è stato trovato: Apple Intelligence rilegge su questo Mac. Installa Claude perché subentri."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Claude“ nerastas: šiame „Mac“ peržiūri „Apple Intelligence“. Įdiekite „Claude“, kad jis perimtų darbą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nav atrasts: šajā Mac datorā pārskata Apple Intelligence. Instalējiet Claude, lai tas pārņemtu darbu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ma nstabx: Apple Intelligence jirrevedi fuq dan il-Mac. Installa Claude biex jieħu f’idejh hu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude is niet gevonden: Apple Intelligence kijkt na op deze Mac. Installeer Claude om het te laten overnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono Claude: Apple Intelligence sprawdza na tym Macu. Zainstaluj Claude, aby przejął to zadanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude não foi encontrado: a Apple Intelligence revisa neste Mac. Instale o Claude para que ele assuma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nu a fost găsit: Apple Intelligence revizuiește pe acest Mac. Instalați Claude ca să preia el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не найден: на этом Mac проверяет Apple Intelligence. Установите Claude, чтобы он взял проверку на себя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude sa nenašiel: na tomto Macu kontroluje Apple Intelligence. Nainštalujte Claude, aby kontrolu prevzal."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ni bil najden: na tem Macu pregleduje Apple Intelligence. Namestite Claude, da prevzame."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude hittades inte: Apple Intelligence granskar på den här datorn. Installera Claude så tar det över."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не знайдено: на цьому Mac перевіряє Apple Intelligence. Установіть Claude, щоб він узяв перевірку на себе."
          }
        }
      }
    },
