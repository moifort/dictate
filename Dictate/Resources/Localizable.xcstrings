            "value": "Semnătura actualizării nu este validă. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись обновления недействительна. %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis aktualizácie je neplatný. %@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis posodobitve ni veljaven. %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdateringens signatur är ogiltig. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпис оновлення недійсний. %@"
          }
        }
      }
    },
    "La touche de dictée répond dès que le Mac démarre.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавишът за диктовка работи веднага щом Mac се стартира."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klávesa diktování funguje hned po spuštění Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringstasten virker, så snart Mac starter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diktiertaste funktioniert, sobald der Mac startet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πλήκτρο υπαγόρευσης λειτουργεί μόλις ξεκινήσει το Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dictation key works as soon as the Mac starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tecla de dictado funciona en cuanto arranca el Mac."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimisklahv töötab kohe, kui Mac käivitub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelunäppäin toimii heti, kun Mac käynnistyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La touche de dictée répond dès que le Mac démarre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipka za diktiranje radi čim se Mac pokrene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálóbillentyű a Mac indulásától kezdve működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasto di dettatura funziona non appena il Mac si avvia."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktavimo klavišas veikia vos paleidus „Mac“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktēšanas taustiņš darbojas, tiklīdz Mac dators ir startēts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-tasta tad-dettatura taħdem hekk kif jibda l-Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dicteertoets werkt zodra de Mac opstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz dyktowania działa od razu po uruchomieniu Maca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tecla de ditado funciona assim que o Mac inicia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasta de dictare funcționează imediat ce pornește Mac-ul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша диктовки работает сразу после запуска Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kláves diktovania funguje hneď po spustení Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipka za narekovanje deluje, takoj ko se Mac zažene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringstangenten fungerar så fort datorn startar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіша диктування працює одразу після запуску Mac."
          }
        }
      }
    },
    "La transcription est plus fiable quand elle sait à l'avance dans quelle langue vous parlez. Dictate a repris celle de macOS ; changez-la si vous dictez dans une autre. Les termes techniques anglais restent reconnus.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипцията е по-надеждна, когато знае предварително на какъв език говорите. Dictate взе езика, който използва macOS; сменете го, ако диктувате на друг. Английските технически термини продължават да се разпознават."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepis je spolehlivější, když předem ví, jakým jazykem mluvíte. Dictate převzal jazyk, který používá macOS; změňte ho, pokud diktujete v jiném. Anglické odborné výrazy jsou rozpoznávány i nadále."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transskriptionen er mere pålidelig, når den på forhånd ved, hvilket sprog du taler. Dictate har valgt det, macOS bruger; skift det, hvis du dikterer på et andet. Engelske fagudtryk genkendes stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription ist zuverlässiger, wenn sie vorab weiß, welche Sprache du sprichst. Dictate hat die Sprache von macOS übernommen; ändere sie, wenn du in einer anderen diktierst. Englische Fachbegriffe werden weiterhin erkannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μεταγραφή είναι πιο αξιόπιστη όταν γνωρίζει εκ των προτέρων ποια γλώσσα μιλάτε. Το Dictate πήρε αυτήν που χρησιμοποιεί το macOS· αλλάξτε την αν υπαγορεύετε σε άλλη. Οι αγγλικοί τεχνικοί όροι εξακολουθούν να αναγνωρίζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription is more reliable when it knows in advance which language you speak. Dictate took the one macOS uses; change it if you dictate in another. English technical terms are still recognized."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción es más fiable cuando sabe de antemano qué idioma hablas. Dictate ha tomado el que usa macOS; cámbialo si dictas en otro. Los términos técnicos en inglés se siguen reconociendo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptsioon on usaldusväärsem, kui see teab ette, mis keeles te räägite. Dictate võttis keele, mida kasutab macOS; muutke seda, kui dikteerite teises keeles. Ingliskeelsed tehnilised terminid tuntakse endiselt ära."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Litterointi on luotettavampaa, kun se tietää etukäteen, mitä kieltä puhut. Dictate otti käyttöön macOS:n kielen; vaihda se, jos sanelet toisella kielellä. Englanninkieliset tekniset termit tunnistetaan silti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription est plus fiable quand elle sait à l'avance dans quelle langue vous parlez. Dictate a repris celle de macOS ; changez-la si vous dictez dans une autre. Les termes techniques anglais restent reconnus."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripcija je pouzdanija kad unaprijed zna kojim jezikom govorite. Dictate je preuzeo jezik koji koristi macOS; promijenite ga ako diktirate na drugom. Engleski tehnički izrazi i dalje se prepoznaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átírás megbízhatóbb, ha előre tudja, milyen nyelven beszél. A Dictate a macOS által használt nyelvet vette át; módosítsa, ha másik nyelven diktál. Az angol szakkifejezéseket továbbra is felismeri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione è più affidabile quando sa in anticipo che lingua parli. Dictate ha preso quella usata da macOS; cambiala se detti in un’altra. I termini tecnici inglesi vengono comunque riconosciuti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripcija patikimesnė, kai iš anksto žino, kokia kalba kalbate. „Dictate“ pasirinko kalbą, kurią naudoja „macOS“; pakeiskite ją, jei diktuojate kita. Angliški techniniai terminai vis tiek atpažįstami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripcija ir uzticamāka, ja tā jau iepriekš zina, kādā valodā runājat. Dictate pārņēma valodu, ko izmanto macOS; mainiet to, ja diktējat citā. Angļu tehniskie termini joprojām tiek atpazīti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-traskrizzjoni tkun aktar affidabbli meta tkun taf minn qabel b’liema lingwa titkellem. Dictate ħa dik li juża macOS; ibdilha jekk tiddetta b’oħra. It-termini tekniċi bl-Ingliż xorta jingħarfu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transcriptie is betrouwbaarder als ze vooraf weet welke taal je spreekt. Dictate heeft de taal van macOS overgenomen; wijzig die als je in een andere dicteert. Engelse vaktermen worden nog steeds herkend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja jest bardziej niezawodna, gdy z góry wie, w jakim języku mówisz. Dictate przyjęło język używany przez macOS; zmień go, jeśli dyktujesz w innym. Angielskie terminy techniczne są nadal rozpoznawane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição é mais confiável quando sabe de antemão que idioma você fala. O Dictate adotou o que o macOS usa; altere-o se você dita em outro. Os termos técnicos em inglês continuam sendo reconhecidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrierea este mai fiabilă când știe dinainte ce limbă vorbiți. Dictate a luat limba folosită de macOS; schimbați-o dacă dictați în alta. Termenii tehnici în engleză sunt recunoscuți în continuare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка надёжнее, когда заранее известно, на каком языке вы говорите. Dictate взял язык, который использует macOS; измените его, если диктуете на другом. Английские технические термины по-прежнему распознаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepis je spoľahlivejší, keď vopred vie, akým jazykom hovoríte. Dictate prevzal jazyk, ktorý používa macOS; zmeňte ho, ak diktujete v inom. Anglické odborné výrazy sa rozpoznávajú aj naďalej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepis je zanesljivejši, če vnaprej ve, kateri jezik govorite. Dictate je prevzel jezik, ki ga uporablja macOS; spremenite ga, če narekujete v drugem. Angleški strokovni izrazi so še vedno prepoznani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptionen blir pålitligare när den i förväg vet vilket språk du talar. Dictate valde det som macOS använder; ändra det om du dikterar på ett annat. Engelska facktermer känns fortfarande igen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипція надійніша, коли заздалегідь відомо, якою мовою ви говорите. Dictate узяв мову, яку використовує macOS; змініть її, якщо диктуєте іншою. Англійські технічні терміни й надалі розпізнаються."
          }
        }
      }
    },
