          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoidke dikteerimisklahvi all ja rääkige: teie statistika ilmub siia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä sanelunäppäintä painettuna ja puhu: tilastosi näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la touche de dictée et parlez : vos statistiques apparaîtront ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite tipku za diktiranje i govorite: ovdje će se prikazati vaša statistika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa lenyomva a diktálóbillentyűt, és beszéljen: itt jelennek meg a statisztikái."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il tasto di dettatura e parla: le tue statistiche appariranno qui."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikykite nuspaudę diktavimo klavišą ir kalbėkite: čia bus rodoma jūsų statistika."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turiet nospiestu diktēšanas taustiņu un runājiet: šeit parādīsies jūsu statistika."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żomm it-tasta tad-dettatura magħfusa u tkellem: l-istatistika tiegħek tidher hawn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de dicteertoets ingedrukt en spreek: je statistieken verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klawisz dyktowania i mów: tutaj pojawią się Twoje statystyki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a tecla de ditado pressionada e fale: suas estatísticas aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți apăsată tasta de dictare și vorbiți: statisticile dvs. vor apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
