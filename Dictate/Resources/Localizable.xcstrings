    "L'application, les modèles de transcription, les statistiques et les réglages seront placés dans la Corbeille ou effacés, et Dictate quittera.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложението, моделите за транскрипция, статистиката и настройките ще бъдат преместени в кошчето или изтрити, а Dictate ще се затвори."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace, modely přepisu, statistiky a nastavení budou přesunuty do koše nebo smazány a Dictate se ukončí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen, transskriptionsmodellerne, statistikken og indstillingerne flyttes til papirkurven eller slettes, og Dictate slutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App, die Transkriptionsmodelle, die Statistiken und die Einstellungen werden in den Papierkorb gelegt oder gelöscht, und Dictate wird beendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή, τα μοντέλα μεταγραφής, τα στατιστικά και οι ρυθμίσεις θα μεταφερθούν στον Κάδο ή θα σβηστούν, και το Dictate θα τερματιστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app, the transcription models, the statistics and the settings will be moved to the Trash or erased, and Dictate will quit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app, los modelos de transcripción, las estadísticas y los ajustes se trasladarán a la papelera o se borrarán, y Dictate se cerrará."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendus, transkriptsioonimudelid, statistika ja seaded teisaldatakse prügikasti või kustutatakse ning Dictate suletakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Appi, litterointimallit, tilastot ja asetukset siirretään roskakoriin tai poistetaan, ja Dictate lopetetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application, les modèles de transcription, les statistiques et les réglages seront placés dans la Corbeille ou effacés, et Dictate quittera."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija, modeli za transkripciju, statistika i postavke premjestit će se u Smeće ili obrisati, a Dictate će se zatvoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app, az átírási modellek, a statisztikák és a beállítások a Kukába kerülnek vagy törlődnek, és a Dictate kilép."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app, i modelli di trascrizione, le statistiche e le impostazioni verranno spostati nel Cestino o cancellati, e Dictate si chiuderà."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programa, transkripcijos modeliai, statistika ir nustatymai bus perkelti į šiukšlinę arba ištrinti, o „Dictate“ bus išjungta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotne, transkripcijas modeļi, statistika un iestatījumi tiks pārvietoti uz miskasti vai izdzēsti, un Dictate tiks aizvērts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-app, il-mudelli tat-traskrizzjoni, l-istatistika u s-settings se jitmexxew fit-Trash jew jitħassru, u Dictate jingħalaq."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app, de transcriptiemodellen, de statistieken en de instellingen worden naar de prullenmand verplaatst of gewist, en Dictate stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja, modele transkrypcji, statystyki i ustawienia zostaną przeniesione do Kosza lub wymazane, a Dictate zakończy działanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O app, os modelos de transcrição, as estatísticas e os ajustes serão movidos para o Lixo ou apagados, e o Dictate será encerrado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația, modelele de transcriere, statisticile și configurările vor fi mutate în coș sau șterse, iar Dictate se va închide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение, модели расшифровки, статистика и настройки будут перемещены в Корзину или стёрты, а Dictate завершит работу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia, modely prepisu, štatistiky a nastavenia sa presunú do koša alebo vymažú a Dictate sa ukončí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija, modeli za prepis, statistika in nastavitve bodo premaknjeni v koš ali izbrisani, Dictate pa se bo zaprl."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen, transkriptionsmodellerna, statistiken och inställningarna flyttas till papperskorgen eller raderas, och Dictate avslutas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програму, моделі транскрипції, статистику та параметри буде переміщено до Смітника або стерто, а Dictate завершить роботу."
          }
        }
      }
    },
