    "Abonnement Claude détecté : Claude relit vos dictées.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Открит е абонамент за Claude: Claude преглежда диктовките ви."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjištěno předplatné Claude: vaše diktáty kontroluje Claude."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-abonnement fundet: Claude gennemgår dine diktater."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-Abo erkannt: Claude korrigiert deine Diktate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εντοπίστηκε συνδρομή Claude: το Claude ελέγχει τις υπαγορεύσεις σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude subscription detected: Claude reviews your dictations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscripción a Claude detectada: Claude revisa tus dictados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuvastati Claude’i tellimus: Claude vaatab teie dikteerimised üle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-tilaus havaittu: Claude tarkistaa sanelusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnement Claude détecté : Claude relit vos dictées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkrivena pretplata na Claude: Claude pregledava vaše diktate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-előfizetés észlelve: a Claude ellenőrzi a diktálásait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonamento Claude rilevato: Claude rilegge le tue dettature."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptikta „Claude“ prenumerata: „Claude“ peržiūri jūsų diktavimus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrasts Claude abonements: Claude pārskata jūsu diktējumus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instab abbonament ta’ Claude: Claude jirrevedi d-dettaturi tiegħek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-abonnement gevonden: Claude kijkt je dictaten na."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto subskrypcję Claude: Claude sprawdza Twoje dyktowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinatura do Claude detectada: o Claude revisa seus ditados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonament Claude detectat: Claude vă revizuiește dictările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружена подписка Claude: Claude проверяет ваши диктовки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zistené predplatné Claude: vaše diktáty kontroluje Claude."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznana naročnina Claude: Claude pregleduje vaše nareke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-abonnemang hittat: Claude granskar dina dikteringar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виявлено підписку Claude: Claude перевіряє ваші диктування."
          }
        }
      }
    },
