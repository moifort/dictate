    "CLI claude introuvable. Installez Claude Code ou indiquez son chemin dans les réglages.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI claude не е открит. Инсталирайте Claude Code или задайте пътя в Настройки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI claude nenalezeno. Nainstalujte Claude Code nebo zadejte cestu v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-CLI ikke fundet. Installer Claude Code, eller angiv stien i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-CLI nicht gefunden. Installiere Claude Code oder gib den Pfad in den Einstellungen an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CLI claude δεν βρέθηκε. Εγκαταστήστε το Claude Code ή ορίστε τη διαδρομή του στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
