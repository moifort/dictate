    "Limite d'utilisation de Claude atteinte : réessayez après sa réinitialisation.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнат е лимитът за използване на Claude: опитайте отново, след като се нулира."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosažen limit využití Claude: zkuste to znovu po jeho obnovení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudes forbrugsgrænse er nået: prøv igen, når den er nulstillet."
